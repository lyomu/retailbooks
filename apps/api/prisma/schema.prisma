  @@index([organizationId, contactId])
  @@map("contact_tax_ids")
}

enum PortalUserStatus {
  ACTIVE
  REVOKED
}

enum PortalInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Customer-scoped access to the portal. This is deliberately not an OrganizationMember: a portal
/// user cannot inherit internal permissions or reach arbitrary organization records.
model PortalUser {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  contactId       String             @map("contact_id") @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  status          PortalUserStatus   @default(ACTIVE)
  invitedByUserId String             @map("invited_by_user_id") @db.Uuid
