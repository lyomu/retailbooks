model VendorCreditAllocation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  vendorCreditId String       @map("vendor_credit_id") @db.Uuid
  billId         String       @map("bill_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor") @db.BigInt
  journalId      String       @unique @map("journal_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCredit   VendorCredit @relation(fields: [vendorCreditId], references: [id], onDelete: Cascade)
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  journal        Journal      @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([organizationId, vendorCreditId])
  @@index([organizationId, billId])
  @@map("vendor_credit_allocations")
}

/// Payable-side mirror of PaymentReceived: posted once at recording time (AP debit vs cash/bank
/// credit) -- no draft state. `allocatedMinor`/`unappliedMinor`/`status` are derived and updated
/// atomically alongside `PaymentMadeAllocation` rows and the target bills'
/// paidMinor/balanceMinor/status in `PaymentsMadeService#allocate`, mirroring
/// `PaymentsService#allocate` exactly.
model PaymentMade {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  vendorId          String                  @map("vendor_id") @db.Uuid
  paymentNumber     String?                 @map("payment_number") @db.VarChar(64)
  status            PaymentStatus           @default(UNAPPLIED)
  paidDate          DateTime                @map("paid_date") @db.Date
  currency          String                  @db.Char(3)
  amountMinor       BigInt                  @map("amount_minor") @db.BigInt
  allocatedMinor    BigInt                  @default(0) @map("allocated_minor") @db.BigInt
  unappliedMinor    BigInt                  @map("unapplied_minor") @db.BigInt
  paidFromAccountId String?                 @map("paid_from_account_id") @db.Uuid
  journalId         String?                 @unique @map("journal_id") @db.Uuid
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paidFromAccount   LedgerAccount?          @relation("PaymentMadePaidFromAccount", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  journal           Journal?                @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("PaymentMadeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations       PaymentMadeAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, paidDate])
  @@index([organizationId, vendorId])
  @@map("payments_made")
}

/// One payment's application against one bill. Unique on (paymentId, billId) -- a second
/// allocation from the same payment to the same bill increments this row rather than inserting a
/// duplicate, mirroring PaymentAllocation.
model PaymentMadeAllocation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  billId         String       @map("bill_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor") @db.BigInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        PaymentMade  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([organizationId, paymentId])
  @@index([organizationId, billId])
  @@map("payment_made_allocations")
}

/// A template that `RecurringBillsService#runDueTemplates` sweeps to generate real bills via
/// `BillsService#createDraft`/`issueBill` -- mirrors `RecurringInvoiceTemplate` exactly. `autoCreate`
/// gates auto-*issue* after the draft is always created (same slightly-confusing but consistent
/// naming as the Sales original -- kept for consistency rather than renamed, since the meaning
/// isn't unique to this template). No `autoSend` -- Bills are received documents, not sent ones.
model RecurringBillTemplate {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                      @map("organization_id") @db.Uuid
  vendorId             String                      @map("vendor_id") @db.Uuid
  cadence              RecurringCadence
  startDate            DateTime                    @map("start_date") @db.Date
  endDate              DateTime?                   @map("end_date") @db.Date
  nextRunDate          DateTime                    @map("next_run_date") @db.Date
  autoCreate           Boolean                     @default(true) @map("auto_create")
  active               Boolean                     @default(true)
  currency             String                      @db.Char(3)
  lastRunOccurrenceKey String?                     @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String                      @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor               Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("RecurringBillTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                RecurringBillTemplateLine[]

  @@index([organizationId, active, nextRunDate])
  @@index([organizationId, vendorId])
  @@map("recurring_bill_templates")
}

model RecurringBillTemplateLine {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  templateId          String                @map("template_id") @db.Uuid
  lineNumber          Int                   @map("line_number") @db.SmallInt
  itemId              String?               @map("item_id") @db.Uuid
  descriptionSnapshot String                @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal               @db.Decimal(18, 4)
  unitPriceMinor      BigInt                @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt                @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt                @map("line_total_minor") @db.BigInt
  taxCodeId           String?               @map("tax_code_id") @db.Uuid
  accountId           String?               @map("account_id") @db.Uuid
  warehouseId         String?               @map("warehouse_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template            RecurringBillTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item                Item?                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?              @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  account             LedgerAccount?        @relation("RecurringBillTemplateLineAccount", fields: [accountId], references: [id], onDelete: Restrict)
  warehouse           Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([templateId, lineNumber])
  @@index([organizationId, templateId])
  @@map("recurring_bill_template_lines")
}

/// A template that `RecurringExpensesService#runDueTemplates` sweeps to generate real expenses via
/// `ExpensesService#createDraft`/`post`. Unlike RecurringBillTemplate, mirrors Expense's own flat
/// single-amount shape directly -- no line-items sub-table, since Expense itself has none.
model RecurringExpenseTemplate {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  payeeVendorId        String?          @map("payee_vendor_id") @db.Uuid
  payeeName            String?          @map("payee_name") @db.VarChar(160)
  cadence              RecurringCadence
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime?        @map("end_date") @db.Date
  nextRunDate          DateTime         @map("next_run_date") @db.Date
  autoCreate           Boolean          @default(true) @map("auto_create")
  active               Boolean          @default(true)
  paidThroughAccountId String           @map("paid_through_account_id") @db.Uuid
  categoryId           String?          @map("category_id") @db.Uuid
  currency             String           @db.Char(3)
  amountMinor          BigInt           @map("amount_minor") @db.BigInt
  taxCodeId            String?          @map("tax_code_id") @db.Uuid
  lastRunOccurrenceKey String?          @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payeeVendor          Vendor?          @relation(fields: [payeeVendorId], references: [id], onDelete: SetNull)
  paidThroughAccount   LedgerAccount    @relation("RecurringExpenseTemplatePaidThroughAccount", fields: [paidThroughAccountId], references: [id], onDelete: Restrict)
  category             ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCode              TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  createdBy            User             @relation("RecurringExpenseTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, active, nextRunDate])
  @@index([organizationId, payeeVendorId])
  @@map("recurring_expense_templates")
}

enum OpeningBalanceBatchStatus {
  DRAFT
  VALIDATED
  FINALIZED
  VOID
}

/// One side of a party-level opening balance. RECEIVABLE lines roll into the accounts_receivable
/// control account and must reference a contact; PAYABLE lines roll into accounts_payable and must
/// reference a vendor.
enum OpeningBalancePartySide {
  RECEIVABLE
  PAYABLE
}

model OpeningBalanceBatch {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  status            OpeningBalanceBatchStatus @default(DRAFT)
  asOfDate          DateTime                  @map("as_of_date") @db.Date
  description       String?                   @db.VarChar(240)
  journalId         String?                   @unique @map("journal_id") @db.Uuid
  validatedAt       DateTime?                 @map("validated_at") @db.Timestamptz(6)
  finalizedAt       DateTime?                 @map("finalized_at") @db.Timestamptz(6)
  finalizedByUserId String?                   @map("finalized_by_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal           Journal?                  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  finalizedBy       User?                     @relation("OpeningBalanceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  lines             OpeningBalanceLine[]
  partyLines        OpeningBalancePartyLine[]

  @@index([organizationId, status])
  @@index([organizationId, asOfDate])
  @@map("opening_balance_batches")
}

model OpeningBalanceLine {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  batchId        String              @map("batch_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  debitMinor     BigInt              @default(0) @map("debit_minor")
  creditMinor    BigInt              @default(0) @map("credit_minor")
  description    String?             @db.VarChar(240)
  batch          OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  account        LedgerAccount       @relation("OpeningBalanceLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, batchId])
  @@map("opening_balance_lines")
}

model OpeningBalancePartyLine {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  batchId        String                  @map("batch_id") @db.Uuid
  side           OpeningBalancePartySide
  amountMinor    BigInt                  @map("amount_minor")
  nameSnapshot   String                  @map("name_snapshot") @db.VarChar(160)
  contactId      String?                 @map("contact_id") @db.Uuid
  vendorId       String?                 @map("vendor_id") @db.Uuid
  batch          OpeningBalanceBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact        Contact?                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  vendor         Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([organizationId, batchId])
  @@index([organizationId, side])
  @@map("opening_balance_party_lines")
}

model RecurringJournalTemplate {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                         @map("organization_id") @db.Uuid
  name                 String                         @db.VarChar(120)
  memo                 String?                        @db.VarChar(240)
  cadence              RecurringCadence
  startDate            DateTime                       @map("start_date") @db.Date
  endDate              DateTime?                      @map("end_date") @db.Date
  nextRunDate          DateTime                       @map("next_run_date") @db.Date
  active               Boolean                        @default(true)
  lastRunOccurrenceKey String?                        @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String                         @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines                RecurringJournalTemplateLine[]
  createdBy            User                           @relation("RecurringJournalTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  vendor               Vendor?                        @relation(fields: [vendorId], references: [id])
  vendorId             String?                        @db.Uuid

  @@index([organizationId, active, nextRunDate])
  @@map("recurring_journal_templates")
}

model RecurringJournalTemplateLine {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  templateId     String                   @map("template_id") @db.Uuid
  lineNumber     Int                      @map("line_number") @db.SmallInt
  accountId      String                   @map("account_id") @db.Uuid
  debitMinor     BigInt                   @default(0) @map("debit_minor")
  creditMinor    BigInt                   @default(0) @map("credit_minor")
  description    String?                  @db.VarChar(240)
  template       RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account        LedgerAccount            @relation("RecurringJournalTemplateLineAccount", fields: [accountId], references: [id], onDelete: Restrict)
  organization   Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId, templateId])
  @@map("recurring_journal_template_lines")
}

/// One period-end FX revaluation execution. The batch restates foreign-currency monetary balances
/// to the reporting-rate value as of `as_of_date` and posts only the aggregate difference through
/// the posting-rule library -- distinct from `prepareFxPosting`'s per-journal conversion.
model FxRevaluationRun {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  asOfDate        DateTime     @map("as_of_date") @db.Date
  baseCurrency    String       @map("base_currency") @db.Char(3)
  journalId       String       @unique @map("journal_id") @db.Uuid
  gainMinor       BigInt       @default(0) @map("gain_minor")
  lossMinor       BigInt       @default(0) @map("loss_minor")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal         Journal      @relation("FxRevaluationJournal", fields: [journalId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("FxRevaluationRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, asOfDate])
  @@index([organizationId, createdAt])
  @@map("fx_revaluation_runs")
}

/// Cash-rounding policy for document totals. NONE keeps exact computed totals; HALF_UP rounds the
/// payable amount to `rounding_unit_minor` and posts the difference to the rounding account.
enum RoundingMode {
  NONE
  HALF_UP
}

// --- Phase 5: Banking & Reconciliation ---

enum FinancialAccountType {
  BANK
  CASH
  CREDIT_CARD
  OTHER
}

/// V1 ships CSV only; the enum is the extension seam for OFX/QIF adapters.
enum StatementImportFormat {
  CSV
}

enum StatementImportStatus {
  IMPORTED
  PARTIALLY_IMPORTED
  FAILED
}

enum BankTransactionDirection {
  INFLOW
  OUTFLOW
}

/// What became of a transaction after review. MATCHED links to an existing book entry;
/// POSTED means the transaction itself generated a ledger entry (categorize/split);
/// EXCLUDED records an explicit reason and has no ledger impact.
enum BankTransactionDisposition {
  UNRESOLVED
  MATCHED
  POSTED
  EXCLUDED
}

enum MatchTargetType {
  PAYMENT_RECEIVED
  PAYMENT_MADE
  EXPENSE
  TRANSFER
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  POSTED
  VOID
}

model FinancialAccount {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(120)
  type                FinancialAccountType
  currency            String               @db.Char(3)
  glAccountId         String               @map("gl_account_id") @db.Uuid
  openingBalanceMinor BigInt               @default(0) @map("opening_balance_minor")
  active              Boolean              @default(true)
  lastActivityAt      DateTime?            @map("last_activity_at") @db.Timestamptz(6)
  createdByUserId     String               @map("created_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  glAccount           LedgerAccount        @relation("FinancialAccountGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("FinancialAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  statementImports    StatementImport[]
  bankTransactions    BankTransaction[]
  reconciliations     Reconciliation[]
  transfersFrom       Transfer[]           @relation("TransferFromAccount")
  transfersTo         Transfer[]           @relation("TransferToAccount")

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("financial_accounts")
}

model StatementImport {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  financialAccountId String                @map("financial_account_id") @db.Uuid
  format             StatementImportFormat
  status             StatementImportStatus
  fileName           String                @map("file_name") @db.VarChar(200)
  totalRows          Int                   @default(0) @map("total_rows")
  importedCount      Int                   @default(0) @map("imported_count")
  duplicateCount     Int                   @default(0) @map("duplicate_count")
  failedCount        Int                   @default(0) @map("failed_count")
  /// Parsed rows with per-row outcome, kept for the failed-row download.
  rows               Json
  createdByUserId    String                @map("created_by_user_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  createdBy          User                  @relation("StatementImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bankTransactions   BankTransaction[]

  @@index([organizationId, financialAccountId, createdAt])
  @@map("statement_imports")
}

model BankTransaction {
  id                 String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                             @map("organization_id") @db.Uuid
  financialAccountId String                             @map("financial_account_id") @db.Uuid
  statementImportId  String?                            @map("statement_import_id") @db.Uuid
  transactionDate    DateTime                           @map("transaction_date") @db.Date
  description        String                             @db.VarChar(240)
  reference          String?                            @db.VarChar(120)
  direction          BankTransactionDirection
  amountMinor        BigInt                             @map("amount_minor")
  currency           String                             @db.Char(3)
  /// sha256 over account|date|direction|amount|normalized description|normalized reference;
  /// unique per account so re-imports deduplicate instead of double-posting.
  fingerprint        String                             @db.VarChar(64)
  disposition        BankTransactionDisposition         @default(UNRESOLVED)
  excludeReason      String?                            @map("exclude_reason") @db.VarChar(240)
  suggestedAccountId String?                            @map("suggested_account_id") @db.Uuid
  suggestedContactId String?                            @map("suggested_contact_id") @db.Uuid
  suggestedVendorId  String?                            @map("suggested_vendor_id") @db.Uuid
  suggestedTags      String[]                           @default([]) @map("suggested_tags")
  appliedFromRuleId  String?                            @map("applied_from_rule_id") @db.Uuid
  postedJournalId    String?                            @unique @map("posted_journal_id") @db.Uuid
  match              Match?
  createdAt          DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount                   @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  statementImport    StatementImport?                   @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  suggestedAccount   LedgerAccount?                     @relation("BankTransactionSuggestedAccount", fields: [suggestedAccountId], references: [id], onDelete: SetNull)
  postedJournal      Journal?                           @relation("BankTransactionPostedJournal", fields: [postedJournalId], references: [id], onDelete: Restrict)
  clearedIn          ReconciliationClearedTransaction[] @relation("ReconciliationClearedTransaction")

  @@unique([financialAccountId, fingerprint])
  @@index([organizationId, financialAccountId, disposition])
  @@index([organizationId, financialAccountId, transactionDate])
  @@map("bank_transactions")
}

model Match {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  bankTransactionId String          @unique @map("bank_transaction_id") @db.Uuid
  targetType        MatchTargetType @map("target_type")
  targetId          String          @map("target_id") @db.Uuid
  note              String?         @db.VarChar(240)
  matchedByUserId   String          @map("matched_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  matchedBy         User            @relation("MatchCreatedBy", fields: [matchedByUserId], references: [id], onDelete: Restrict)

  /// The core invariant: one source document can be claimed by at most one bank transaction.
  @@unique([targetType, targetId])
  @@index([organizationId, targetType, targetId])
  @@map("bank_transaction_matches")
}

model BankRule {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  name             String         @db.VarChar(120)
  priority         Int
  active           Boolean        @default(true)
  /// false = every condition must hold; true = any single condition is enough.
  matchAny         Boolean        @default(false) @map("match_any")
  conditions       Json
  suggestAccountId String?        @map("suggest_account_id") @db.Uuid
  suggestContactId String?        @map("suggest_contact_id") @db.Uuid
  suggestVendorId  String?        @map("suggest_vendor_id") @db.Uuid
  suggestTags      String[]       @default([]) @map("suggest_tags")
  stopOnMatch      Boolean        @default(false) @map("stop_on_match")
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suggestAccount   LedgerAccount? @relation("BankRuleSuggestAccount", fields: [suggestAccountId], references: [id], onDelete: SetNull)
  createdBy        User           @relation("BankRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, active, priority])
  @@map("bank_rules")
}

model Reconciliation {
  id                  String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                             @map("organization_id") @db.Uuid
  financialAccountId  String                             @map("financial_account_id") @db.Uuid
  statementStartDate  DateTime                           @map("statement_start_date") @db.Date
  statementEndDate    DateTime                           @map("statement_end_date") @db.Date
  openingBalanceMinor BigInt                             @map("opening_balance_minor")
  closingBalanceMinor BigInt                             @map("closing_balance_minor")
  status              ReconciliationStatus               @default(IN_PROGRESS)
  completedAt         DateTime?                          @map("completed_at") @db.Timestamptz(6)
  completedByUserId   String?                            @map("completed_by_user_id") @db.Uuid
  reopenedAt          DateTime?                          @map("reopened_at") @db.Timestamptz(6)
  reopenedByUserId    String?                            @map("reopened_by_user_id") @db.Uuid
  reopenReason        String?                            @map("reopen_reason") @db.VarChar(240)
  createdAt           DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialAccount    FinancialAccount                   @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  completedBy         User?                              @relation("ReconciliationCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  reopenedBy          User?                              @relation("ReconciliationReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  clearedTransactions ReconciliationClearedTransaction[]

  @@index([organizationId, financialAccountId, status])
  @@map("reconciliations")
}

model ReconciliationClearedTransaction {
  reconciliationId String          @map("reconciliation_id") @db.Uuid
  transactionId    String          @map("transaction_id") @db.Uuid
  markedAt         DateTime        @default(now()) @map("marked_at") @db.Timestamptz(6)
  reconciliation   Reconciliation  @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction      BankTransaction @relation("ReconciliationClearedTransaction", fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([reconciliationId, transactionId])
  @@index([transactionId])
  @@map("reconciliation_cleared_transactions")
}

model Transfer {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  transferNumber         String?          @map("transfer_number") @db.VarChar(64)
  status                 TransferStatus   @default(POSTED)
  transferDate           DateTime         @map("transfer_date") @db.Date
  description            String?          @db.VarChar(240)
  fromFinancialAccountId String           @map("from_financial_account_id") @db.Uuid
  toFinancialAccountId   String           @map("to_financial_account_id") @db.Uuid
  fromCurrency           String           @map("from_currency") @db.Char(3)
  toCurrency             String           @map("to_currency") @db.Char(3)
  fromAmountMinor        BigInt           @map("from_amount_minor")
  toAmountMinor          BigInt           @map("to_amount_minor")
  exchangeRate           Decimal?         @map("exchange_rate") @db.Decimal(20, 10)
  journalId              String           @unique @map("journal_id") @db.Uuid
  voidedAt               DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidJournalId          String?          @unique @map("void_journal_id") @db.Uuid
  createdByUserId        String           @map("created_by_user_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromFinancialAccount   FinancialAccount @relation("TransferFromAccount", fields: [fromFinancialAccountId], references: [id], onDelete: Restrict)
  toFinancialAccount     FinancialAccount @relation("TransferToAccount", fields: [toFinancialAccountId], references: [id], onDelete: Restrict)
  journal                Journal          @relation("TransferJournal", fields: [journalId], references: [id], onDelete: Restrict)
  voidJournal            Journal?         @relation("TransferVoidJournal", fields: [voidJournalId], references: [id], onDelete: Restrict)
  createdBy              User             @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, transferNumber])
  @@index([organizationId, transferDate])
  @@map("transfers")
}

// --- Phase 7: Projects & Time ------------------------------------------------------------------

enum TagStatus {
  ACTIVE
  ARCHIVED
}

/// A free-form reporting dimension, introduced here alongside `Project` because decision D1 puts
/// both `project_id` and `tag_id` on `JournalLine` in one migration rather than widening the
/// largest table in the schema twice. Deliberately minimal in Phase 7 -- Phase 9 makes tags a
/// first-class report filter and is where any hierarchy or grouping belongs, if it is needed.
model Tag {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(80)
  status         TagStatus     @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]

  @@unique([organizationId, name])
  @@map("tags")
}

enum ProjectStatus {
  OPEN
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// How a project's work turns into revenue. `TIME_AND_MATERIALS` bills approved time and billable
/// expenses through the generate-invoice path; `FIXED_PRICE` bills on its own schedule and tracks
/// time for cost and margin only; `NON_BILLABLE` (internal work, warranty, pre-sales) tracks cost
/// with no revenue path at all -- its time is never invoiceable, and that is enforced, not advisory.
enum ProjectBillingMethod {
  TIME_AND_MATERIALS
  FIXED_PRICE
  NON_BILLABLE
}

/// A unit of client work that revenue and cost are attributed to. The customer is a `Contact` --
/// the same entity Invoices bill -- so project revenue and the customer's AR are the same party by
/// construction rather than by name matching.
///
/// `budgetAmountMinor`/`budgetHours` are the project-level totals; `ProjectBudget` breaks those
/// down per task where a project needs it. Both are advisory in V1: exceeding a budget is surfaced
/// in profitability, not blocked, because stopping work mid-engagement is a business decision the
/// product should not make on the organization's behalf.
model Project {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  code              String?              @db.VarChar(40)
  name              String               @db.VarChar(160)
  customerId        String?              @map("customer_id") @db.Uuid
  managerUserId     String?              @map("manager_user_id") @db.Uuid
  status            ProjectStatus        @default(OPEN)
  billingMethod     ProjectBillingMethod @default(TIME_AND_MATERIALS) @map("billing_method")
  currency          String               @db.Char(3)
  startsOn          DateTime?            @map("starts_on") @db.Date
  endsOn            DateTime?            @map("ends_on") @db.Date
  budgetAmountMinor BigInt?              @map("budget_amount_minor") @db.BigInt
  budgetHours       Decimal?             @map("budget_hours") @db.Decimal(12, 2)
  defaultRateMinor  BigInt?              @map("default_rate_minor") @db.BigInt
  description       String?              @db.VarChar(500)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Contact?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  manager           User?                @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks             ProjectTask[]
  timeEntries       TimeEntry[]
  projectExpenses   ProjectExpense[]
  budgets           ProjectBudget[]
  invoiceLines      InvoiceLine[]
  journalLines      JournalLine[]
  expenses          Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@map("projects")
}

enum ProjectTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// A named piece of work inside a project. Tasks carry no permissions of their own -- access is
/// inherited from the project, so there is exactly one place a project's visibility is decided.
model ProjectTask {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  name            String            @db.VarChar(160)
  assigneeUserId  String?           @map("assignee_user_id") @db.Uuid
  status          ProjectTaskStatus @default(OPEN)
  estimateHours   Decimal?          @map("estimate_hours") @db.Decimal(12, 2)
  billableDefault Boolean           @default(true) @map("billable_default")
  rateMinor       BigInt?           @map("rate_minor") @db.BigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?             @relation("ProjectTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  timeEntries     TimeEntry[]
  budgets         ProjectBudget[]

  @@index([organizationId, projectId])
  @@map("project_tasks")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
}

/// Recorded work. `hours` is a decimal rather than minutes because timesheets are entered and
/// approved in decimal hours, and turning hours into money is the same integer-minor-unit
/// arithmetic the rest of the product uses.
///
/// Submitted time is immutable until it is rejected or unlocked, mirroring the posted-journal
/// discipline: an approval that can be edited afterwards is not an approval. `invoiceLineId` is
/// the invoiced-once guard -- it only ever moves from null to a value, through a conditional
/// update that matches zero rows on a second attempt, and it is unique so two entries can never
/// claim the same line and corrupt drill-down.
model TimeEntry {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  taskId           String?         @map("task_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  entryDate        DateTime        @map("entry_date") @db.Date
  hours            Decimal         @db.Decimal(9, 2)
  billable         Boolean         @default(true)
  rateMinor        BigInt?         @map("rate_minor") @db.BigInt
  costRateMinor    BigInt?         @map("cost_rate_minor") @db.BigInt
  note             String?         @db.VarChar(500)
  status           TimeEntryStatus @default(DRAFT)
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedByUserId String?         @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz(6)
  decisionComment  String?         @map("decision_comment") @db.VarChar(500)
  invoiceLineId    String?         @unique @map("invoice_line_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task             ProjectTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user             User            @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy       User?           @relation("TimeEntryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  invoiceLine      InvoiceLine?    @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId, status])
  @@index([organizationId, userId, entryDate])
  @@map("time_entries")
}

/// A posted `Expense` attributed to a project, optionally re-billed to the customer with a markup.
///
/// The expense stays the source of truth for the amount -- this row never restates it, so project
/// cost cannot drift from the ledger. `expenseId` is unique: an expense belongs to at most one
/// project, which is what makes project cost a partition of spend rather than a double count.
/// `invoiceLineId` carries the same invoiced-once guard as `TimeEntry`.
model ProjectExpense {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  expenseId      String       @unique @map("expense_id") @db.Uuid
  billable       Boolean      @default(true)
  markupPercent  Decimal?     @map("markup_percent") @db.Decimal(7, 4)
  invoiceLineId  String?      @unique @map("invoice_line_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  invoiceLine    InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@map("project_expenses")
}

/// Per-task budget breakdown beneath `Project`'s own `budgetAmountMinor`/`budgetHours` totals.
///
/// `taskId` is required, which is what makes `@@unique([projectId, taskId])` a real constraint:
/// PostgreSQL treats NULLs as distinct, so a nullable column in a unique tuple would have let
/// unlimited project-level rows accumulate while looking constrained. Work not attached to a task
/// is budgeted by the project total, which already exists on `Project` and needs no second home.
model ProjectBudget {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  taskId            String       @map("task_id") @db.Uuid
  budgetHours       Decimal?     @map("budget_hours") @db.Decimal(12, 2)
  budgetAmountMinor BigInt?      @map("budget_amount_minor") @db.BigInt
  note              String?      @db.VarChar(240)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task              ProjectTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([projectId, taskId])
  @@index([organizationId, projectId])
  @@map("project_budgets")
}

// --- Phase 8: Globalization ---

enum CountryPackStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// Launch-tier per D3/8B: only a fully reviewed pack may back a compliance-sensitive setup.
/// Tier A  -- reviewed; may carry compliance claims.
/// Tier B  -- generic defaults, no compliance claim of any kind.
/// Tier C  -- blocked from compliance-sensitive setup entirely.
enum CountryPackTier {
  TIER_A_REVIEWED
  TIER_B_GENERIC
  TIER_C_BLOCKED
}

/// The versioned country pack, promoted from `jurisdiction-catalog.ts` per D3. Global reference
/// data, not organization-scoped: organizations pin a (code, version) pair through
/// `OrganizationPreference.countryPackCode/Version`, and finalized documents snapshot both.
///
/// The static catalog remains the seed source and the fresh-database fallback; this table is what
/// makes packs versionable and publishable (Phase 12's admin console builds on it). The Kenya pack
/// keeps its explicit _demonstration_ labelling: it seeds as TIER_B_GENERIC, and no read path may
/// upgrade an unreviewed pack into an implied compliance claim.
model CountryPack {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String            @db.VarChar(8)
  version              String            @db.VarChar(24)
  countryCode          String            @map("country_code") @db.VarChar(2)
  name                 String            @db.VarChar(120)
  status               CountryPackStatus @default(DRAFT)
  tier                 CountryPackTier   @default(TIER_B_GENERIC)
  /// `CountryPackDefaults` shape from the catalog: currency, locale, timeZone, fiscal-year start,
  /// chart template, journal numbering. Stored as JSON so a new pack version can add fields
  /// without a migration; readers validate against the contract, not the column type.
  defaults             Json              @db.JsonB
  notes                Json              @db.JsonB
  /// Entity types this pack is allowed to back (e.g. INVOICE, BILL, EXPENSE).
  supportedEntityTypes Json              @db.JsonB
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(6)
  deprecatedAt         DateTime?         @map("deprecated_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  taxPacks             TaxPack[]
  documentRules        DocumentRule[]

  @@unique([code, version])
  @@index([code, status])
  @@map("country_packs")
}

/// Tax metadata versioned underneath a country pack: labels, default rates, registration fields,
/// inclusive/exclusive rules, exemptions, and reporting mappings. Versioned per pack (not per
/// country) so publishing a pack revision carries its tax semantics atomically.
model TaxPack {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId      String      @map("country_pack_id") @db.Uuid
  version            String      @db.VarChar(24)
  name               String      @db.VarChar(120)
  /// `{ label, ratePercent, treatment, recoverable }[]` -- the seeded defaults the tax engine
  /// offers when an organization adopts this pack.
  rates              Json        @db.JsonB
  registrationFields Json        @default("[]") @map("registration_fields") @db.JsonB
  exemptions         Json        @default("[]") @db.JsonB
  reportingMappings  Json        @default("{}") @map("reporting_mappings") @db.JsonB
  notes              Json        @default("[]") @db.JsonB
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  countryPack        CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, version])
  @@index([countryPackId])
  @@map("tax_packs")
}

/// Per-country document requirements behind a country pack: which legal fields a document type
/// must carry, numbering constraints, display labels, and footer/legal text.
model DocumentRule {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId        String      @map("country_pack_id") @db.Uuid
  /// Mirrors `DocumentSnapshot`'s documentType vocabulary (INVOICE, CREDIT_NOTE, ...).
  documentType         String      @map("document_type") @db.VarChar(40)
  requiredLegalFields  Json        @default("[]") @map("required_legal_fields") @db.JsonB
  numberingConstraints Json        @default("{}") @map("numbering_constraints") @db.JsonB
  labels               Json        @default("{}") @db.JsonB
  footerText           String?     @map("footer_text") @db.VarChar(500)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  countryPack          CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, documentType])
  @@index([countryPackId])
  @@map("document_rules")
}

/// The canonical, machine-readable data artifact of a finalized document -- JSON/XML-ready for
/// e-invoicing and reporting integrations. Deliberately a separate table from `DocumentSnapshot`,
/// which stays the rendered-PDF artifact: the render can be regenerated or discarded without ever
/// touching the data record, and vice versa. Pack code/version are pinned here at write time for
/// the same reason they are pinned on `Invoice`/`Bill`.
model StructuredInvoice {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  documentType         String       @map("document_type") @db.VarChar(40)
  documentId           String       @map("document_id") @db.Uuid
  countryPackCode      String       @map("country_pack_code") @db.VarChar(8)
  countryPackVersion   String       @map("country_pack_version") @db.VarChar(24)
  /// Version of the canonical payload shape itself, so the JSON contract can evolve without
  /// invalidating stored artifacts.
  payloadSchemaVersion String       @default("1") @map("payload_schema_version") @db.VarChar(12)
  payload              Json         @db.JsonB
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, documentId])
  @@index([organizationId, documentType])
  @@map("structured_invoices")
}

/// A named, reusable report configuration. The definition itself stays in the versioned code
/// registry; this row stores only user choices, so a saved report automatically receives fixes to
/// its source-of-truth query without copying executable report logic into JSON.
model SavedReport {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  name             String            @db.VarChar(120)
  reportKey        String            @map("report_key") @db.VarChar(80)
  filters          Json              @default("{}") @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("SavedReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  scheduledReports ScheduledReport[]

  @@unique([organizationId, createdByUserId, name])
  @@index([organizationId, reportKey])
  @@index([organizationId, createdByUserId, updatedAt])
  @@map("saved_reports")
}

model DomainEventOutbox {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  aggregateType  String           @map("aggregate_type") @db.VarChar(60)
  aggregateId    String           @map("aggregate_id") @db.VarChar(100)
  eventName      String           @map("event_name") @db.VarChar(100)
  eventVersion   Int              @default(1) @map("event_version") @db.SmallInt
  payload        Json             @default("{}") @db.JsonB
  causationId    String?          @map("causation_id") @db.Uuid
  correlationId  String?          @map("correlation_id") @db.Uuid
  state          DomainEventState @default(PENDING)
  availableAt    DateTime         @default(now()) @map("available_at") @db.Timestamptz(6)
  leasedAt       DateTime?        @map("leased_at") @db.Timestamptz(6)
  leaseToken     String?          @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(6)
  dispatchedAt   DateTime?        @map("dispatched_at") @db.Timestamptz(6)
  attempts       Int              @default(0)
  lastError      String?          @map("last_error") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([state, availableAt])
  @@index([organizationId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("domain_event_outbox")
}

model ApprovalPolicy {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  createdByUserId   String               @map("created_by_user_id") @db.Uuid
  name              String               @db.VarChar(120)
  targetType        ApprovalTargetType   @map("target_type")
  status            ApprovalPolicyStatus @default(DRAFT)
  priority          Int                  @default(0)
  conditions        Json                 @default("{}") @db.JsonB
  allowSelfApproval Boolean              @default(false) @map("allow_self_approval")
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User                 @relation("ApprovalPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  steps             ApprovalPolicyStep[]
  requests          ApprovalRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, targetType, status, priority])
  @@map("approval_policies")
}

