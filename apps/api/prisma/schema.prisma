// ---------------------------------------------------------------------------------------------
// Phase 12 - Platform Admin
//
// Everything below is *platform*-scoped rather than tenant-scoped: rows either have no
// `organizationId` discriminator at all, or reference an organization from the outside rather than
// living inside one. That is the point of the phase, and also its main hazard, so the boundary is a
// table (`PlatformAdmin`) rather than a configuration value, and every mutation lands in its own
// append-only log (`PlatformAuditEvent`).
// ---------------------------------------------------------------------------------------------

/// Ordered by privilege: each role includes everything the one before it can do.
enum PlatformRole {
  SUPPORT
  OPERATIONS
  SUPERADMIN
}

enum PlatformAdminStatus {
  ACTIVE
  REVOKED
}

/// A person's standing permission to use the platform console. Distinct from `OrganizationMember`
/// in every way that matters: it is not scoped to a tenant, it is never granted by a tenant, and it
/// confers no membership of any organization.
model PlatformAdmin {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @unique @map("user_id") @db.Uuid
  role            PlatformRole         @default(SUPPORT)
  status          PlatformAdminStatus  @default(ACTIVE)
  /// Null only for a bootstrap grant, which by definition has no existing administrator to vouch
  /// for it. Every later grant names the administrator who created it.
  grantedByUserId String?              @map("granted_by_user_id") @db.Uuid
  note            String?              @db.VarChar(500)
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User                 @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User?                @relation("PlatformAdminGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  auditEvents     PlatformAuditEvent[]

  @@index([status, role])
  @@map("platform_admins")
}

/// Append-only record of every mutating platform-administrator action. Deliberately separate from
/// tenant `AuditEvent`: many of these actions are cross-tenant, and the ones that are not still must
/// not appear in a tenant's own audit trail as though the tenant performed them.
model PlatformAuditEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformAdminId String        @map("platform_admin_id") @db.Uuid
  actorUserId     String        @map("actor_user_id") @db.Uuid
  eventKey        String        @map("event_key") @db.VarChar(100)
  targetType      String        @map("target_type") @db.VarChar(60)
  targetId        String?       @map("target_id") @db.VarChar(100)
  /// Set when the action concerns one tenant, so a support question about a single organization can
  /// be answered without scanning the whole log. Null for global reference-data changes.
  organizationId  String?       @map("organization_id") @db.Uuid
  /// Required by the service layer for any action that changes a tenant's standing, so a suspension
  /// can still be explained months later.
  reason          String?       @db.VarChar(500)
  before          Json?         @map("before_json") @db.JsonB
  after           Json?         @map("after_json") @db.JsonB
  ipHash          String?       @map("ip_hash") @db.Char(64)
  occurredAt      DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  actor           User          @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([organizationId, occurredAt])
  @@index([eventKey, occurredAt])
  @@map("platform_audit_events")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// A sellable tier. The price fields exist so a future billing provider has somewhere to land;
/// nothing in Phase 12 charges anyone, and no provider identifiers are stored here.
model Plan {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String                     @unique @db.VarChar(40)
  name            String                     @db.VarChar(120)
  description     String?                    @db.VarChar(500)
  status          PlanStatus                 @default(DRAFT)
  /// At most one active plan is the default; new organizations are subscribed to it.
  isDefault       Boolean                    @default(false) @map("is_default")
  trialDays       Int                        @default(0) @map("trial_days") @db.SmallInt
  priceMinor      BigInt                     @default(0) @map("price_minor")
  currency        String                     @default("USD") @db.Char(3)
  billingInterval BillingInterval            @default(MONTHLY) @map("billing_interval")
  sortOrder       Int                        @default(0) @map("sort_order") @db.SmallInt
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  entitlements    PlanEntitlement[]
  subscriptions   OrganizationSubscription[]
  flagRules       FeatureFlagRule[]

  @@index([status, sortOrder])
  @@map("plans")
}

/// One capability or limit carried by a plan. A null `limitValue` means "no limit" rather than
/// zero; a withdrawn capability is `enabled = false`, which is a different statement from a limit
/// of 0.
model PlanEntitlement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  key        String   @db.VarChar(60)
  enabled    Boolean  @default(true)
  limitValue Int?     @map("limit_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_entitlements")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// One organization's current plan. One row per organization: the history lives in
/// `PlatformAuditEvent`, which already records who changed a plan, when, and why.
model OrganizationSubscription {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus @default(TRIALING)
  trialEndsAt    DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  startedAt      DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  cancelledAt    DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@map("organization_subscriptions")
}

enum FeatureFlagStatus {
  ACTIVE
  ARCHIVED
}

/// Scope of one targeting rule, declared least to most specific. The resolver reads this order
/// directly, so adding a scope means deciding where it sits in the precedence chain.
enum FeatureFlagScope {
  GLOBAL
  COUNTRY
  PLAN
  ORGANIZATION
}

model FeatureFlag {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String            @unique @db.VarChar(60)
  name           String            @db.VarChar(120)
  description    String?           @db.VarChar(500)
  /// The answer when no rule matches, so a flag with no rules is still well-defined.
  defaultEnabled Boolean           @default(false) @map("default_enabled")
  status         FeatureFlagStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rules          FeatureFlagRule[]

  @@index([status])
  @@map("feature_flags")
}

/// One targeting rule. Exactly one scope column is populated, matching `scope`; GLOBAL populates
/// none. Keeping the three as separate typed columns rather than one polymorphic string means a
/// plan or organization rule carries a real foreign key and cannot outlive what it targets.
model FeatureFlagRule {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flagId         String           @map("flag_id") @db.Uuid
  scope          FeatureFlagScope
  countryCode    String?          @map("country_code") @db.Char(2)
  planId         String?          @map("plan_id") @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  enabled        Boolean
  note           String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  flag           FeatureFlag      @relation(fields: [flagId], references: [id], onDelete: Cascade)
  plan           Plan?            @relation(fields: [planId], references: [id], onDelete: Cascade)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([flagId, scope])
  @@index([organizationId])
  @@map("feature_flag_rules")
}
