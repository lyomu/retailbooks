generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AuthProvider {
  PASSWORD
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ActionTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum OnboardingStep {
  PROFILE
  JURISDICTION
  ACCOUNTING
  TAX
  NUMBERING
  TEAM
  REVIEW
  COMPLETE
}

enum BusinessType {
  SOLE_PROPRIETOR
  PARTNERSHIP
  LIMITED_COMPANY
  NONPROFIT
  COOPERATIVE
  OTHER
}

enum AccountingBasis {
  ACCRUAL
  CASH
}

enum TaxTreatment {
  EXCLUSIVE
  INCLUSIVE
}

enum NumberingReset {
  NEVER
  ANNUAL
  MONTHLY
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COST_OF_SALES
  OTHER_INCOME
  OTHER_EXPENSE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

enum LedgerAccountStatus {
  ACTIVE
  ARCHIVED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum CurrencyStatus {
  ACTIVE
  INACTIVE
}

enum TaxCodeStatus {
  ACTIVE
  ARCHIVED
}

enum ContactType {
  CUSTOMER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum ContactAddressKind {
  BILLING
  SHIPPING
}

enum ItemType {
  GOODS
  SERVICE
  NON_STOCK
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model User {
  id                               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                            String                     @unique @db.Citext
  displayName                      String                     @map("display_name") @db.VarChar(120)
  emailVerifiedAt                  DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  status                           UserStatus                 @default(PENDING_VERIFICATION)
  createdAt                        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authMethods                      AuthMethod[]
  sessions                         Session[]
  actionTokens                     ActionToken[]
  securityEvents                   SecurityEvent[]
  auditEvents                      AuditEvent[]
  memberships                      OrganizationMember[]
  organizationsCreated             Organization[]             @relation("OrganizationCreatedBy")
  invitationsSent                  OrganizationInvitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted              OrganizationInvitation[]   @relation("InvitationAcceptedBy")
  journalsCreated                  Journal[]                  @relation("JournalCreatedBy")
  journalsPosted                   Journal[]                  @relation("JournalPostedBy")
  openingBalancesFinalized         OpeningBalanceBatch[]      @relation("OpeningBalanceFinalizedBy")
  recurringJournalTemplatesCreated RecurringJournalTemplate[] @relation("RecurringJournalTemplateCreatedBy")
  fxRevaluationRunsCreated         FxRevaluationRun[]         @relation("FxRevaluationRunCreatedBy")
  invoicesCreated                  Invoice[]                  @relation("InvoiceCreatedBy")
  paymentsReceivedCreated          PaymentReceived[]          @relation("PaymentReceivedCreatedBy")
  creditNotesCreated               CreditNote[]               @relation("CreditNoteCreatedBy")
  creditNoteRefundsCreated         CreditNoteRefund[]         @relation("CreditNoteRefundCreatedBy")
  quotesCreated                    Quote[]                    @relation("QuoteCreatedBy")
  salesOrdersCreated               SalesOrder[]               @relation("SalesOrderCreatedBy")
  recurringInvoiceTemplatesCreated RecurringInvoiceTemplate[] @relation("RecurringInvoiceTemplateCreatedBy")
  purchaseOrdersCreated            PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  billsCreated                     Bill[]                     @relation("BillCreatedBy")
  attachmentsUploaded              Attachment[]               @relation("AttachmentUploadedBy")
  expensesCreated                  Expense[]                  @relation("ExpenseCreatedBy")
  vendorCreditsCreated             VendorCredit[]             @relation("VendorCreditCreatedBy")
  paymentsMadeCreated              PaymentMade[]              @relation("PaymentMadeCreatedBy")
  recurringBillTemplatesCreated    RecurringBillTemplate[]    @relation("RecurringBillTemplateCreatedBy")
  recurringExpenseTemplatesCreated RecurringExpenseTemplate[] @relation("RecurringExpenseTemplateCreatedBy")

  @@map("users")
}

model AuthMethod {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  provider     AuthProvider @default(PASSWORD)
  providerKey  String?      @map("provider_key") @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("auth_methods")
}

model Session {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  status     SessionStatus @default(ACTIVE)
  userAgent  String?       @map("user_agent") @db.VarChar(512)
  ipHash     String?       @map("ip_hash") @db.Char(64)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model ActionToken {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  purpose    ActionTokenPurpose
  tokenHash  String             @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("action_tokens")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Append-only record of *what changed*. Distinct from SecurityEvent, which records
/// security-relevant signals. Never updated or deleted: tenant users must not mutate audit history.
model AuditEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  eventKey       String        @map("event_key") @db.VarChar(100)
  entityType     String        @map("entity_type") @db.VarChar(60)
  entityId       String?       @map("entity_id") @db.VarChar(100)
  action         AuditAction
  before         Json?         @map("before_json") @db.JsonB
  after          Json?         @map("after_json") @db.JsonB
  metadata       Json          @default("{}") @map("metadata_json") @db.JsonB
  ipHash         String?       @map("ip_hash") @db.Char(64)
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId])
  @@index([eventKey, occurredAt])
  @@map("audit_events")
}

model SecurityEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  eventKey       String        @map("event_key") @db.VarChar(100)
  severity       String        @default("INFO") @db.VarChar(16)
  ipHash         String?       @map("ip_hash") @db.Char(64)
  metadata       Json          @default("{}") @map("metadata_json") @db.JsonB
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([eventKey, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("security_events")
}

/// Tenant root. Every organization-owned row carries `organization_id` and is only reachable
/// through a validated membership of the authenticated user.
model Organization {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName                     String                         @map("legal_name") @db.VarChar(180)
  tradingName                   String?                        @map("trading_name") @db.VarChar(180)
  slug                          String                         @unique @db.VarChar(96)
  businessType                  BusinessType                   @default(OTHER) @map("business_type")
  countryCode                   String                         @map("country_code") @db.Char(2)
  baseCurrency                  String                         @map("base_currency") @db.Char(3)
  timeZone                      String                         @map("time_zone") @db.VarChar(64)
  locale                        String                         @db.VarChar(16)
  fiscalYearStartMonth          Int                            @default(1) @map("fiscal_year_start_month") @db.SmallInt
  fiscalYearStartDay            Int                            @default(1) @map("fiscal_year_start_day") @db.SmallInt
  status                        OrganizationStatus             @default(DRAFT)
  onboardingStep                OnboardingStep                 @default(JURISDICTION) @map("onboarding_step")
  onboardingCompletedAt         DateTime?                      @map("onboarding_completed_at") @db.Timestamptz(6)
  createdByUserId               String                         @map("created_by_user_id") @db.Uuid
  createdAt                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                     User                           @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  preferences                   OrganizationPreference?
  members                       OrganizationMember[]
  invitations                   OrganizationInvitation[]
  securityEvents                SecurityEvent[]
  auditEvents                   AuditEvent[]
  roles                         Role[]
  fiscalYears                   FiscalYear[]
  fiscalPeriods                 FiscalPeriod[]
  documentNumbers               DocumentNumberSequence[]
  documentNumberingConfigs      DocumentNumberingConfig[]
  accounts                      LedgerAccount[]
  journals                      Journal[]
  journalLines                  JournalLine[]
  ledgerIdempotencyKeys         LedgerIdempotencyKey[]
  enabledCurrencies             OrganizationCurrency[]
  exchangeRates                 ExchangeRate[]
  taxCodes                      TaxCode[]
  taxRates                      TaxRate[]
  contacts                      Contact[]
  contactAddresses              ContactAddress[]
  contactTaxIds                 ContactTaxId[]
  units                         Unit[]
  categories                    Category[]
  items                         Item[]
  itemPrices                    ItemPrice[]
  invoices                      Invoice[]
  invoiceLines                  InvoiceLine[]
  paymentsReceived              PaymentReceived[]
  paymentAllocations            PaymentAllocation[]
  creditNotes                   CreditNote[]
  creditNoteLines               CreditNoteLine[]
  creditNoteAllocations         CreditNoteAllocation[]
  creditNoteRefunds             CreditNoteRefund[]
  quotes                        Quote[]
  quoteLines                    QuoteLine[]
  salesOrders                   SalesOrder[]
  salesOrderLines               SalesOrderLine[]
  documentSnapshots             DocumentSnapshot[]
  recurringInvoiceTemplates     RecurringInvoiceTemplate[]
  recurringInvoiceTemplateLines RecurringInvoiceTemplateLine[]
  vendors                       Vendor[]
  vendorAddresses               VendorAddress[]
  vendorTaxIds                  VendorTaxId[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderLines            PurchaseOrderLine[]
  bills                         Bill[]
  billLines                     BillLine[]
  attachments                   Attachment[]
  expenseCategories             ExpenseCategory[]
  expenses                      Expense[]
  vendorCredits                 VendorCredit[]
  vendorCreditLines             VendorCreditLine[]
  vendorCreditAllocations       VendorCreditAllocation[]
  paymentsMade                  PaymentMade[]
  paymentMadeAllocations        PaymentMadeAllocation[]
  recurringBillTemplates        RecurringBillTemplate[]
  recurringBillTemplateLines    RecurringBillTemplateLine[]
  recurringExpenseTemplates     RecurringExpenseTemplate[]
  openingBalanceBatches         OpeningBalanceBatch[]
  recurringJournalTemplates     RecurringJournalTemplate[]
  recurringJournalTemplateLines RecurringJournalTemplateLine[]
  fxRevaluationRuns             FxRevaluationRun[]

  @@index([createdByUserId])
  @@index([status])
  @@map("organizations")
}

/// Global ISO-style currency reference data. Monetary storage remains integer minor units; this
/// table supplies display metadata and the precision required for deterministic FX conversion.
model Currency {
  code                 String                 @id @db.Char(3)
  name                 String                 @db.VarChar(80)
  symbol               String                 @db.VarChar(8)
  decimals             Int                    @db.SmallInt
  status               CurrencyStatus         @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations        OrganizationCurrency[]
  exchangeRatesAsBase  ExchangeRate[]         @relation("ExchangeRateBaseCurrency")
  exchangeRatesAsQuote ExchangeRate[]         @relation("ExchangeRateQuoteCurrency")

  @@index([status])
  @@map("currencies")
}

/// Currencies explicitly enabled for one organization. `isBase` mirrors the protected
/// organizations.base_currency value so settings reads are self-contained and auditable.
model OrganizationCurrency {
  organizationId String       @map("organization_id") @db.Uuid
  currencyCode   String       @map("currency_code") @db.Char(3)
  isBase         Boolean      @default(false) @map("is_base")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency       Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([organizationId, currencyCode])
  @@index([organizationId, enabled])
  @@map("organization_currencies")
}

/// Effective-dated organization rates. A rate means base-currency major units per one quote-
/// currency major unit and is stored as Decimal only at the persistence boundary; conversion uses
/// a scaled BigInt representation in accounting-core.
model ExchangeRate {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  baseCurrency   String       @map("base_currency") @db.Char(3)
  quoteCurrency  String       @map("quote_currency") @db.Char(3)
  rate           Decimal      @db.Decimal(20, 10)
  rateDate       DateTime     @map("rate_date") @db.Date
  source         String       @default("MANUAL") @db.VarChar(40)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  base           Currency     @relation("ExchangeRateBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quote          Currency     @relation("ExchangeRateQuoteCurrency", fields: [quoteCurrency], references: [code], onDelete: Restrict)

  @@unique([organizationId, baseCurrency, quoteCurrency, rateDate])
  @@index([organizationId, quoteCurrency, rateDate])
  @@map("exchange_rates")
}

/// Organization-scoped fiscal year generated from configurable local accounting defaults.
model FiscalYear {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  label          String             @db.VarChar(24)
  startsOn       DateTime           @map("starts_on") @db.Date
  endsOn         DateTime           @map("ends_on") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods        FiscalPeriod[]

  @@unique([organizationId, label])
  @@unique([organizationId, startsOn])
  @@index([organizationId, status])
  @@map("fiscal_years")
}

/// Organization-scoped accounting period. Status changes are controlled by service methods and
/// written with same-transaction SecurityEvent evidence.
model FiscalPeriod {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  fiscalYearId   String             @map("fiscal_year_id") @db.Uuid
  code           String             @db.VarChar(32)
  name           String             @db.VarChar(80)
  startsOn       DateTime           @map("starts_on") @db.Date
  endsOn         DateTime           @map("ends_on") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)
  lockedAt       DateTime?          @map("locked_at") @db.Timestamptz(6)
  reopenedAt     DateTime?          @map("reopened_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear     FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@unique([organizationId, startsOn])
  @@index([organizationId, status])
  @@index([fiscalYearId, startsOn])
  @@map("fiscal_periods")
}

/// Generic document numbering counter. Future journal, invoice, and tax documents can allocate
/// independently without overloading organization_preferences.
model DocumentNumberSequence {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  documentType        String         @map("document_type") @db.VarChar(40)
  scopeKey            String         @map("scope_key") @db.VarChar(32)
  prefix              String         @db.VarChar(16)
  numberPadding       Int            @map("number_padding") @db.SmallInt
  numberingReset      NumberingReset @map("numbering_reset")
  nextNumber          Int            @map("next_number")
  lastAllocatedNumber Int?           @map("last_allocated_number")
  lastAllocatedAt     DateTime?      @map("last_allocated_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, scopeKey], map: "document_number_sequences_org_type_scope_key")
  @@index([organizationId, documentType])
  @@map("document_number_sequences")
}

/// Per-document-type numbering defaults (prefix, padding, next number, reset policy), lazily seeded
/// the first time a document type other than JOURNAL allocates a number. Journal numbering keeps its
/// dedicated columns on organization_preferences; this table generalizes the same shape for every
/// document type that follows.
model DocumentNumberingConfig {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  documentType   String         @map("document_type") @db.VarChar(40)
  prefix         String         @db.VarChar(16)
  numberPadding  Int            @map("number_padding") @db.SmallInt
  nextNumber     Int            @default(1) @map("next_number")
  numberingReset NumberingReset @default(ANNUAL) @map("numbering_reset")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType])
  @@map("document_numbering_configs")
}

/// Organization-scoped accounting, tax, numbering, and country-pack defaults. Configurable
/// software defaults only; they are not a statutory certification.
model OrganizationPreference {
  id                          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId              String          @unique @map("organization_id") @db.Uuid
  accountingBasis             AccountingBasis @default(ACCRUAL) @map("accounting_basis")
  chartTemplate               String          @default("general-business") @map("chart_template") @db.VarChar(60)
  roundingMode                RoundingMode    @default(NONE) @map("rounding_mode")
  roundingUnitMinor           Int?            @map("rounding_unit_minor")
  booksStartDate              DateTime?       @map("books_start_date") @db.Date
  taxRegistered               Boolean         @default(false) @map("tax_registered")
  taxIdentifier               String?         @map("tax_identifier") @db.VarChar(60)
  defaultTaxTreatment         TaxTreatment    @default(EXCLUSIVE) @map("default_tax_treatment")
  defaultTaxRate              Decimal         @default(0) @map("default_tax_rate") @db.Decimal(7, 4)
  journalPrefix               String          @default("JRN") @map("journal_prefix") @db.VarChar(12)
  numberPadding               Int             @default(5) @map("number_padding") @db.SmallInt
  nextJournalNumber           Int             @default(1) @map("next_journal_number")
  numberingReset              NumberingReset  @default(ANNUAL) @map("numbering_reset")
  countryPackCode             String          @map("country_pack_code") @db.VarChar(8)
  countryPackVersion          String          @map("country_pack_version") @db.VarChar(24)
  salesFreeDescriptionDefault Boolean         @default(true) @map("sales_free_description_default")
  createdAt                   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_preferences")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, roleId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.Citext
  roleId           String           @map("role_id") @db.Uuid
  status           InvitationStatus @default(PENDING)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  notifiedAt       DateTime?        @map("notified_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

/// Every organization holds its own copies of the system role templates (isSystem: true) plus any
/// custom roles it creates, so a role's permission set can be adjusted per organization without
/// affecting any other -- the same tenant-isolation shape the rest of the schema uses. There is
/// deliberately no separate "default vs override" table: a role's own RolePermission rows are its
/// complete, effective permission set.
model Role {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  key            String                   @db.VarChar(40)
  name           String                   @db.VarChar(80)
  description    String?                  @db.VarChar(240)
  isSystem       Boolean                  @default(false) @map("is_system")
  isOwnerRole    Boolean                  @default(false) @map("is_owner_role")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  invitations    OrganizationInvitation[]
  permissions    RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId, isSystem])
  @@map("roles")
}

/// A role's granted permission keys. The permission catalog itself is not a database table -- like
/// every other global, static reference catalog in this schema (countries, currencies, business
/// types in `jurisdiction-catalog.ts`), it lives in code as `PERMISSION_CATALOG` and is validated at
/// the application boundary via `isPermissionKey()`, not enforced with a foreign key. A key column
/// backed by a real table would need that table seeded before the very first organization's roles
/// could be created, for no protective value beyond what the application check already provides.
model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(60)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

/// Editable organization-scoped chart of accounts. Accounts are archived rather than hard-deleted
/// once they have journal history.
model LedgerAccount {
  id                                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                                String                         @map("organization_id") @db.Uuid
  code                                          String                         @db.VarChar(24)
  name                                          String                         @db.VarChar(120)
  type                                          LedgerAccountType
  normalBalance                                 LedgerNormalBalance            @map("normal_balance")
  status                                        LedgerAccountStatus            @default(ACTIVE)
  description                                   String?                        @db.VarChar(240)
  systemSeed                                    Boolean                        @default(false) @map("system_seed")
  systemKey                                     String?                        @map("system_key") @db.VarChar(40)
  isControl                                     Boolean                        @default(false) @map("is_control")
  archivedAt                                    DateTime?                      @map("archived_at") @db.Timestamptz(6)
  createdAt                                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                     DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines                                  JournalLine[]
  taxCodesAsSalesAccount                        TaxCode[]                      @relation("TaxCodeSalesAccount")
  taxCodesAsPurchaseAccount                     TaxCode[]                      @relation("TaxCodePurchaseAccount")
  contactsAsReceivableAccount                   Contact[]                      @relation("ContactReceivableAccount")
  itemsAsRevenueAccount                         Item[]                         @relation("ItemRevenueAccount")
  invoiceLinesAsRevenueAccount                  InvoiceLine[]                  @relation("InvoiceLineRevenueAccount")
  paymentsReceivedAsDepositAccount              PaymentReceived[]              @relation("PaymentReceivedDepositAccount")
  creditNoteLinesAsRevenueAccount               CreditNoteLine[]               @relation("CreditNoteLineRevenueAccount")
  vendorsAsPayableAccount                       Vendor[]                       @relation("VendorPayableAccount")
  billLinesAsAccount                            BillLine[]                     @relation("BillLineAccount")
  expenseCategoriesAsAccount                    ExpenseCategory[]              @relation("ExpenseCategoryAccount")
  expensesAsPaidThroughAccount                  Expense[]                      @relation("ExpensePaidThroughAccount")
  vendorCreditLinesAsAccount                    VendorCreditLine[]             @relation("VendorCreditLineAccount")
  paymentsMadeAsPaidFromAccount                 PaymentMade[]                  @relation("PaymentMadePaidFromAccount")
  recurringBillTemplateLinesAsAccount           RecurringBillTemplateLine[]    @relation("RecurringBillTemplateLineAccount")
  recurringExpenseTemplatesAsPaidThroughAccount RecurringExpenseTemplate[]     @relation("RecurringExpenseTemplatePaidThroughAccount")
  openingBalanceLinesAsAccount                  OpeningBalanceLine[]           @relation("OpeningBalanceLineAccount")
  recurringJournalTemplateLinesAsAccount        RecurringJournalTemplateLine[] @relation("RecurringJournalTemplateLineAccount")

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("ledger_accounts")
}

/// Draft and posted journal header. Posted journals are immutable; corrections use reversal.
model Journal {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  reference              String?                 @db.VarChar(64)
  status                 JournalStatus           @default(DRAFT)
  journalDate            DateTime                @map("journal_date") @db.Date
  currency               String                  @db.Char(3)
  exchangeRate           Decimal?                @map("exchange_rate") @db.Decimal(20, 10)
  description            String                  @db.VarChar(240)
  sourceType             String?                 @map("source_type") @db.VarChar(60)
  sourceId               String?                 @map("source_id") @db.VarChar(100)
  postingRule            String?                 @map("posting_rule") @db.VarChar(120)
  postedAt               DateTime?               @map("posted_at") @db.Timestamptz(6)
  postedByUserId         String?                 @map("posted_by_user_id") @db.Uuid
  createdByUserId        String                  @map("created_by_user_id") @db.Uuid
  reversalOfJournalId    String?                 @unique @map("reversal_of_journal_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy              User                    @relation("JournalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  postedBy               User?                   @relation("JournalPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  reversalOf             Journal?                @relation("JournalReversal", fields: [reversalOfJournalId], references: [id], onDelete: Restrict)
  reversalJournal        Journal?                @relation("JournalReversal")
  lines                  JournalLine[]
  invoice                Invoice?
  paymentReceived        PaymentReceived?
  creditNote             CreditNote?
  creditNoteAllocation   CreditNoteAllocation?
  creditNoteRefund       CreditNoteRefund?
  bill                   Bill?
  vendorCreditAllocation VendorCreditAllocation?
  paymentMade            PaymentMade?
  vendorCredit           VendorCredit?
  expense                Expense?
  openingBalanceBatch    OpeningBalanceBatch?
  fxRevaluationRun       FxRevaluationRun?       @relation("FxRevaluationJournal")

  @@unique([organizationId, reference])
  @@index([organizationId, status, journalDate])
  @@index([organizationId, journalDate])
  @@index([reversalOfJournalId])
  @@map("journals")
}

model JournalLine {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  journalId              String        @map("journal_id") @db.Uuid
  accountId              String        @map("account_id") @db.Uuid
  lineNumber             Int           @map("line_number") @db.SmallInt
  description            String?       @db.VarChar(240)
  debitMinor             BigInt        @default(0) @map("debit_minor") @db.BigInt
  creditMinor            BigInt        @default(0) @map("credit_minor") @db.BigInt
  foreignAmountMinor     BigInt?       @map("foreign_amount_minor") @db.BigInt
  exchangeRate           Decimal?      @map("exchange_rate") @db.Decimal(20, 10)
  taxCodeId              String?       @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?       @map("tax_code_snapshot") @db.VarChar(24)
