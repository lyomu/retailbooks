/// Sales invoice header. DRAFT/PENDING_APPROVAL are freely editable; ISSUED is immutable except for
/// the payment-derived status transitions (PARTIALLY_PAID/PAID/OVERDUE) and VOID, mirroring how a
/// posted Journal is immutable except for reversal. `journalId` is set at Issue, when this invoice's
/// lines post AR/revenue/tax through LedgerService.postJournalFromLines.
model Invoice {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                 @map("organization_id") @db.Uuid
  contactId               String                 @map("contact_id") @db.Uuid
  invoiceNumber           String?                @map("invoice_number") @db.VarChar(64)
  status                  InvoiceStatus          @default(DRAFT)
  issueDate               DateTime?              @map("issue_date") @db.Date
  dueDate                 DateTime?              @map("due_date") @db.Date
  currency                String                 @db.Char(3)
  exchangeRate            Decimal?               @map("exchange_rate") @db.Decimal(20, 10)
  subtotalMinor           BigInt                 @default(0) @map("subtotal_minor") @db.BigInt
  taxTotalMinor           BigInt                 @default(0) @map("tax_total_minor") @db.BigInt
  totalMinor              BigInt                 @default(0) @map("total_minor") @db.BigInt
  paidMinor               BigInt                 @default(0) @map("paid_minor") @db.BigInt
  balanceMinor            BigInt                 @default(0) @map("balance_minor") @db.BigInt
  journalId               String?                @unique @map("journal_id") @db.Uuid
  voidedAt                DateTime?              @map("voided_at") @db.Timestamptz(6)
  sentAt                  DateTime?              @map("sent_at") @db.Timestamptz(6)
  createdByUserId         String                 @map("created_by_user_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact                 Contact                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  journal                 Journal?               @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy               User                   @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                   InvoiceLine[]
  allocations             PaymentAllocation[]
  creditNoteAllocations   CreditNoteAllocation[]
  convertedFromQuote      Quote?
  convertedFromSalesOrder SalesOrder?

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, contactId])
  @@map("invoices")
}

model InvoiceLine {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  invoiceId              String         @map("invoice_id") @db.Uuid
  lineNumber             Int            @map("line_number") @db.SmallInt
  itemId                 String?        @map("item_id") @db.Uuid
  descriptionSnapshot    String         @map("description_snapshot") @db.VarChar(240)
  quantity               Decimal        @db.Decimal(18, 4)
  unitPriceMinor         BigInt         @map("unit_price_minor") @db.BigInt
  discountMinor          BigInt         @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor         BigInt         @map("line_total_minor") @db.BigInt
  taxCodeId              String?        @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?        @map("tax_code_snapshot") @db.VarChar(24)
  taxTreatmentSnapshot   TaxTreatment?  @map("tax_treatment_snapshot")
  taxRecoverableSnapshot Boolean?       @map("tax_recoverable_snapshot")
  taxRatePercentSnapshot Decimal?       @map("tax_rate_percent_snapshot") @db.Decimal(7, 4)
  taxableAmountMinor     BigInt?        @map("taxable_amount_minor") @db.BigInt
  taxAmountMinor         BigInt?        @map("tax_amount_minor") @db.BigInt
  revenueAccountId       String?        @map("revenue_account_id") @db.Uuid
  projectTag             String?        @map("project_tag") @db.VarChar(80)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice                Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item                   Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode                TaxCode?       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  revenueAccount         LedgerAccount? @relation("InvoiceLineRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNumber])
  @@index([organizationId, invoiceId])
  @@index([taxCodeId])
  @@map("invoice_lines")
}

enum PaymentStatus {
  UNAPPLIED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

/// A customer payment recorded and posted (deposit-account debit vs AR credit) in one step at
/// recording time -- there is no draft state, unlike Invoice. `allocatedMinor`/`unappliedMinor` and
/// `status` are derived and updated atomically alongside PaymentAllocation rows and the target
/// invoices' paidMinor/balanceMinor/status in PaymentsService#allocate.
model PaymentReceived {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  contactId        String              @map("contact_id") @db.Uuid
  paymentNumber    String?             @map("payment_number") @db.VarChar(64)
  status           PaymentStatus       @default(UNAPPLIED)
  receivedDate     DateTime            @map("received_date") @db.Date
  currency         String              @db.Char(3)
  amountMinor      BigInt              @map("amount_minor") @db.BigInt
  allocatedMinor   BigInt              @default(0) @map("allocated_minor") @db.BigInt
  unappliedMinor   BigInt              @map("unapplied_minor") @db.BigInt
  depositAccountId String?             @map("deposit_account_id") @db.Uuid
  journalId        String?             @unique @map("journal_id") @db.Uuid
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact          Contact             @relation(fields: [contactId], references: [id], onDelete: Restrict)
  depositAccount   LedgerAccount?      @relation("PaymentReceivedDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  journal          Journal?            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy        User                @relation("PaymentReceivedCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, receivedDate])
  @@index([organizationId, contactId])
  @@map("payments_received")
}

/// One payment's application against one invoice. Unique on (paymentId, invoiceId) -- a second
/// allocation from the same payment to the same invoice increments this row rather than inserting a
/// duplicate (see PaymentsService#allocate's upsert).
model PaymentAllocation {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  paymentId      String          @map("payment_id") @db.Uuid
  invoiceId      String          @map("invoice_id") @db.Uuid
  amountMinor    BigInt          @map("amount_minor") @db.BigInt
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        PaymentReceived @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([organizationId, paymentId])
  @@index([organizationId, invoiceId])
  @@map("payment_allocations")
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  REFUNDED
  VOID
}

/// A credit note reduces revenue/tax and lands its value in the `customer_credit` liability account
/// at issue time (not directly in AR -- see CreditNotesService's doc comment for why). Its value is
/// then resolved either by CreditNoteAllocation (moving customer_credit -> accounts_receivable
/// against a specific invoice) or CreditNoteRefund (moving customer_credit -> bank_default as cash),
/// each a real posting of its own -- unlike PaymentAllocation, which is pure bookkeeping.
model CreditNote {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  contactId        String                 @map("contact_id") @db.Uuid
  creditNoteNumber String?                @map("credit_note_number") @db.VarChar(64)
  status           CreditNoteStatus       @default(DRAFT)
  issueDate        DateTime?              @map("issue_date") @db.Date
  currency         String                 @db.Char(3)
  subtotalMinor    BigInt                 @default(0) @map("subtotal_minor") @db.BigInt
  taxTotalMinor    BigInt                 @default(0) @map("tax_total_minor") @db.BigInt
  totalMinor       BigInt                 @default(0) @map("total_minor") @db.BigInt
  appliedMinor     BigInt                 @default(0) @map("applied_minor") @db.BigInt
  refundedMinor    BigInt                 @default(0) @map("refunded_minor") @db.BigInt
  remainingMinor   BigInt                 @default(0) @map("remaining_minor") @db.BigInt
  journalId        String?                @unique @map("journal_id") @db.Uuid
  voidedAt         DateTime?              @map("voided_at") @db.Timestamptz(6)
  sentAt           DateTime?              @map("sent_at") @db.Timestamptz(6)
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact          Contact                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  journal          Journal?               @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("CreditNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines            CreditNoteLine[]
  allocations      CreditNoteAllocation[]
  refunds          CreditNoteRefund[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, contactId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  creditNoteId           String         @map("credit_note_id") @db.Uuid
  lineNumber             Int            @map("line_number") @db.SmallInt
  itemId                 String?        @map("item_id") @db.Uuid
  descriptionSnapshot    String         @map("description_snapshot") @db.VarChar(240)
  quantity               Decimal        @db.Decimal(18, 4)
  unitPriceMinor         BigInt         @map("unit_price_minor") @db.BigInt
  discountMinor          BigInt         @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor         BigInt         @map("line_total_minor") @db.BigInt
  taxCodeId              String?        @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?        @map("tax_code_snapshot") @db.VarChar(24)
  taxTreatmentSnapshot   TaxTreatment?  @map("tax_treatment_snapshot")
  taxRecoverableSnapshot Boolean?       @map("tax_recoverable_snapshot")
  taxRatePercentSnapshot Decimal?       @map("tax_rate_percent_snapshot") @db.Decimal(7, 4)
  taxableAmountMinor     BigInt?        @map("taxable_amount_minor") @db.BigInt
  taxAmountMinor         BigInt?        @map("tax_amount_minor") @db.BigInt
  revenueAccountId       String?        @map("revenue_account_id") @db.Uuid
  projectTag             String?        @map("project_tag") @db.VarChar(80)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote             CreditNote     @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  item                   Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode                TaxCode?       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  revenueAccount         LedgerAccount? @relation("CreditNoteLineRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: Restrict)

  @@unique([creditNoteId, lineNumber])
  @@index([organizationId, creditNoteId])
  @@index([taxCodeId])
  @@map("credit_note_lines")
}

/// One credit note's application against one invoice. Unlike PaymentAllocation, this is a real
/// posting (DR customer_credit, CR accounts_receivable) each time, so a second allocation to the
/// same invoice is a second row with its own journal, not an increment -- no @@unique collapse.
model CreditNoteAllocation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  creditNoteId   String       @map("credit_note_id") @db.Uuid
  invoiceId      String       @map("invoice_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor") @db.BigInt
  journalId      String       @unique @map("journal_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote     CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  journal        Journal      @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([organizationId, creditNoteId])
  @@index([organizationId, invoiceId])
  @@map("credit_note_allocations")
}

/// A cash payout of a credit note's remaining balance (DR customer_credit, CR bank_default). A
/// credit note may be refunded across more than one partial payout, so this is a per-event table
/// like CreditNoteAllocation rather than a single field on CreditNote.
model CreditNoteRefund {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  creditNoteId    String       @map("credit_note_id") @db.Uuid
  amountMinor     BigInt       @map("amount_minor") @db.BigInt
  journalId       String       @unique @map("journal_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNote      CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  journal         Journal      @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("CreditNoteRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, creditNoteId])
  @@map("credit_note_refunds")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

/// A non-posting sales document -- no journalId column, structural proof it never touches the
/// ledger. `convertedInvoiceId` links to the DRAFT invoice created via InvoicesService#createDraft
/// once accepted.
model Quote {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  contactId          String       @map("contact_id") @db.Uuid
  quoteNumber        String?      @map("quote_number") @db.VarChar(64)
  status             QuoteStatus  @default(DRAFT)
  issueDate          DateTime?    @map("issue_date") @db.Date
  expiryDate         DateTime?    @map("expiry_date") @db.Date
  currency           String       @db.Char(3)
  subtotalMinor      BigInt       @default(0) @map("subtotal_minor") @db.BigInt
  totalMinor         BigInt       @default(0) @map("total_minor") @db.BigInt
  convertedInvoiceId String?      @unique @map("converted_invoice_id") @db.Uuid
  sentAt             DateTime?    @map("sent_at") @db.Timestamptz(6)
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  convertedInvoice   Invoice?     @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  createdBy          User         @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines              QuoteLine[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, contactId])
  @@map("quotes")
}

/// Lighter than InvoiceLine -- no tax-snapshot columns, since a quote never posts and so never
/// freezes tax. `taxCodeId` is still carried so conversion can hand it to the new draft invoice.
model QuoteLine {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  quoteId             String       @map("quote_id") @db.Uuid
  lineNumber          Int          @map("line_number") @db.SmallInt
  itemId              String?      @map("item_id") @db.Uuid
  descriptionSnapshot String       @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal      @db.Decimal(18, 4)
  unitPriceMinor      BigInt       @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt       @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt       @map("line_total_minor") @db.BigInt
  taxCodeId           String?      @map("tax_code_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote               Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item                Item?        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@unique([quoteId, lineNumber])
  @@index([organizationId, quoteId])
  @@map("quote_lines")
}

enum SalesOrderStatus {
  DRAFT
  APPROVED
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// A non-posting sales document, structurally identical to Quote -- no journalId column, and
/// `convertedInvoiceId` links to the invoice created on conversion (allowed from CONFIRMED onward,
/// since Phase 6's inventory module doesn't exist yet to give "fulfilled" a real stock meaning).
model SalesOrder {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  contactId          String           @map("contact_id") @db.Uuid
  orderNumber        String?          @map("order_number") @db.VarChar(64)
  status             SalesOrderStatus @default(DRAFT)
  issueDate          DateTime?        @map("issue_date") @db.Date
  currency           String           @db.Char(3)
  subtotalMinor      BigInt           @default(0) @map("subtotal_minor") @db.BigInt
  totalMinor         BigInt           @default(0) @map("total_minor") @db.BigInt
  convertedInvoiceId String?          @unique @map("converted_invoice_id") @db.Uuid
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  convertedInvoice   Invoice?         @relation(fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  createdBy          User             @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines              SalesOrderLine[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, contactId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  salesOrderId        String       @map("sales_order_id") @db.Uuid
  lineNumber          Int          @map("line_number") @db.SmallInt
  itemId              String?      @map("item_id") @db.Uuid
  descriptionSnapshot String       @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal      @db.Decimal(18, 4)
  unitPriceMinor      BigInt       @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt       @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt       @map("line_total_minor") @db.BigInt
  taxCodeId           String?      @map("tax_code_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder          SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item                Item?        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, lineNumber])
  @@index([organizationId, salesOrderId])
  @@map("sales_order_lines")
}

/// Caches a rendered PDF for one document (Invoice/CreditNote/Quote) so a re-send never re-renders --
/// keyed on (organizationId, documentType, documentId), one row per document for its lifetime.
model DocumentSnapshot {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  documentType   String       @map("document_type") @db.VarChar(40)
  documentId     String       @map("document_id") @db.Uuid
  storageKey     String       @map("storage_key") @db.VarChar(500)
  renderedAt     DateTime     @default(now()) @map("rendered_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentType, documentId])
  @@index([organizationId, documentType])
  @@map("document_snapshots")
}

enum RecurringCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// A template that `RecurringInvoicesService#runDueTemplates` sweeps to generate real invoices via
/// `InvoicesService#createDraft`/`issueInvoice` -- no new posting logic, this only ever calls 2D's
/// existing paths. `lastRunOccurrenceKey` is a denormalized convenience/audit field; the actual
/// double-generation guard is the shared `LedgerIdempotencyKey` mechanism (operation
/// `'RECURRING_INVOICE_GENERATE'`), the same pattern already used by Invoices/Payments/Credit Notes.
model RecurringInvoiceTemplate {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                         @map("organization_id") @db.Uuid
  contactId            String                         @map("contact_id") @db.Uuid
  cadence              RecurringCadence
  startDate            DateTime                       @map("start_date") @db.Date
  endDate              DateTime?                      @map("end_date") @db.Date
  nextRunDate          DateTime                       @map("next_run_date") @db.Date
  autoCreate           Boolean                        @default(true) @map("auto_create")
  autoSend             Boolean                        @default(false) @map("auto_send")
  active               Boolean                        @default(true)
  currency             String                         @db.Char(3)
  lastRunOccurrenceKey String?                        @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String                         @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact              Contact                        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy            User                           @relation("RecurringInvoiceTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                RecurringInvoiceTemplateLine[]

  @@index([organizationId, active, nextRunDate])
  @@index([organizationId, contactId])
  @@map("recurring_invoice_templates")
}

model RecurringInvoiceTemplateLine {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                   @map("organization_id") @db.Uuid
  templateId          String                   @map("template_id") @db.Uuid
  lineNumber          Int                      @map("line_number") @db.SmallInt
  itemId              String?                  @map("item_id") @db.Uuid
  descriptionSnapshot String                   @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal                  @db.Decimal(18, 4)
  unitPriceMinor      BigInt                   @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt                   @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt                   @map("line_total_minor") @db.BigInt
  taxCodeId           String?                  @map("tax_code_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template            RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item                Item?                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?                 @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@unique([templateId, lineNumber])
  @@index([organizationId, templateId])
  @@map("recurring_invoice_template_lines")
}

// --- Phase 3: Purchases ---

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ISSUED
  CLOSED
  CANCELLED
}

/// Independent of `status`: whether goods against this PO have arrived. A manually-set flag, not a
/// quantity-tracked subsystem -- Phase 3 has no stock-movement/inventory-line modeling (that's the
/// separate "Inventory" domain in the blueprint's core data model, a later phase).
enum PurchaseOrderReceiptStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  RECEIVED
}

/// A non-posting purchase document, structurally close to SalesOrder -- no journalId column. Unlike
/// SalesOrder, has an explicit ISSUED step (the point it's sent to the vendor and gets its number,
/// mirroring Bills/Invoices' issue-time numbering rather than SalesOrder's approve-time numbering)
/// and tracks billing progress against itself via `billedMinor`/`totalMinor` the way Invoice tracks
/// `paidMinor`/`balanceMinor`, since one PO can be billed across multiple Bills (see BillsService).
model PurchaseOrder {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                     @map("organization_id") @db.Uuid
  vendorId             String                     @map("vendor_id") @db.Uuid
  orderNumber          String?                    @map("order_number") @db.VarChar(64)
  status               PurchaseOrderStatus        @default(DRAFT)
  receiptStatus        PurchaseOrderReceiptStatus @default(NOT_RECEIVED) @map("receipt_status")
  issueDate            DateTime?                  @map("issue_date") @db.Date
  expectedDeliveryDate DateTime?                  @map("expected_delivery_date") @db.Date
  deliveryNote         String?                    @map("delivery_note") @db.VarChar(500)
  currency             String                     @db.Char(3)
  subtotalMinor        BigInt                     @default(0) @map("subtotal_minor") @db.BigInt
  totalMinor           BigInt                     @default(0) @map("total_minor") @db.BigInt
  billedMinor          BigInt                     @default(0) @map("billed_minor") @db.BigInt
  createdByUserId      String                     @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor               Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                PurchaseOrderLine[]
  bills                Bill[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  purchaseOrderId     String        @map("purchase_order_id") @db.Uuid
  lineNumber          Int           @map("line_number") @db.SmallInt
  itemId              String?       @map("item_id") @db.Uuid
  descriptionSnapshot String        @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal       @db.Decimal(18, 4)
  unitPriceMinor      BigInt        @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt        @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt        @map("line_total_minor") @db.BigInt
  taxCodeId           String?       @map("tax_code_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item                Item?         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?      @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  billLines           BillLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_lines")
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// Payable-side mirror of Invoice: `issueBill` posts a journal crediting AP and debiting each
/// line's expense/inventory/asset account plus recoverable tax (`BillsService#issueBill` mirrors
/// `InvoicesService#issueInvoice`'s idempotency-lock/row-lock/tax-freeze/post/number-allocate shape
/// exactly, sign-flipped). `vendorReference` is the vendor's own bill number as written on their
/// document -- distinct from `billNumber`, which this organization allocates on issue the way
/// `invoiceNumber` is allocated.
model Bill {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  vendorId                String                   @map("vendor_id") @db.Uuid
  purchaseOrderId         String?                  @map("purchase_order_id") @db.Uuid
  billNumber              String?                  @map("bill_number") @db.VarChar(64)
  vendorReference         String?                  @map("vendor_reference") @db.VarChar(64)
  status                  BillStatus               @default(DRAFT)
  issueDate               DateTime?                @map("issue_date") @db.Date
  dueDate                 DateTime?                @map("due_date") @db.Date
  currency                String                   @db.Char(3)
  exchangeRate            Decimal?                 @map("exchange_rate") @db.Decimal(20, 10)
  subtotalMinor           BigInt                   @default(0) @map("subtotal_minor") @db.BigInt
  taxTotalMinor           BigInt                   @default(0) @map("tax_total_minor") @db.BigInt
  totalMinor              BigInt                   @default(0) @map("total_minor") @db.BigInt
  paidMinor               BigInt                   @default(0) @map("paid_minor") @db.BigInt
  balanceMinor            BigInt                   @default(0) @map("balance_minor") @db.BigInt
  journalId               String?                  @unique @map("journal_id") @db.Uuid
  voidedAt                DateTime?                @map("voided_at") @db.Timestamptz(6)
  createdByUserId         String                   @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor                  Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder           PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  journal                 Journal?                 @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation("BillCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                   BillLine[]
  paymentAllocations      PaymentMadeAllocation[]
  vendorCreditAllocations VendorCreditAllocation[]
  vendorCreditsAsSource   VendorCredit[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, vendorId])
  @@map("bills")
}

model BillLine {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  billId                 String             @map("bill_id") @db.Uuid
  purchaseOrderLineId    String?            @map("purchase_order_line_id") @db.Uuid
  lineNumber             Int                @map("line_number") @db.SmallInt
  itemId                 String?            @map("item_id") @db.Uuid
  descriptionSnapshot    String             @map("description_snapshot") @db.VarChar(240)
  quantity               Decimal            @db.Decimal(18, 4)
  unitPriceMinor         BigInt             @map("unit_price_minor") @db.BigInt
  discountMinor          BigInt             @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor         BigInt             @map("line_total_minor") @db.BigInt
  taxCodeId              String?            @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?            @map("tax_code_snapshot") @db.VarChar(24)
  taxTreatmentSnapshot   TaxTreatment?      @map("tax_treatment_snapshot")
  taxRecoverableSnapshot Boolean?           @map("tax_recoverable_snapshot")
  taxRatePercentSnapshot Decimal?           @map("tax_rate_percent_snapshot") @db.Decimal(7, 4)
  taxableAmountMinor     BigInt?            @map("taxable_amount_minor") @db.BigInt
  taxAmountMinor         BigInt?            @map("tax_amount_minor") @db.BigInt
  accountId              String?            @map("account_id") @db.Uuid
  projectTag             String?            @map("project_tag") @db.VarChar(80)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bill                   Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  purchaseOrderLine      PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  item                   Item?              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode                TaxCode?           @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  account                LedgerAccount?     @relation("BillLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([billId, lineNumber])
  @@index([organizationId, billId])
  @@index([taxCodeId])
  @@map("bill_lines")
}

enum AttachmentEntityType {
  BILL
  EXPENSE
}

/// Generic polymorphic attachment (entityType + entityId, no FK relation to the entity tables --
/// mirrors DocumentSnapshot's own documentType/documentId polymorphic shape), so it isn't scoped to
/// one Phase 3 entity and can be reused for other attachment needs later without a new table.
/// `StorageService` (already generic S3-compatible storage, not sales/PDF-specific) is reused as-is.
model Attachment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  entityType       AttachmentEntityType @map("entity_type")
  entityId         String               @map("entity_id") @db.Uuid
  filename         String               @db.VarChar(255)
  contentType      String               @map("content_type") @db.VarChar(120)
  storageKey       String               @map("storage_key") @db.VarChar(500)
  sizeBytes        Int                  @map("size_bytes")
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User                 @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}

/// Maps a purchasing category to a chart-of-accounts entry, so an Expense picks a category rather
/// than an account directly. Distinct from the catalog `Category` model (item/catalog-scoped, has
/// `parentCategoryId`/`items`, no account link) -- overloading that model would conflate two
/// unrelated concepts.
model ExpenseCategory {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String                     @map("organization_id") @db.Uuid
  name                      String                     @db.VarChar(120)
  accountId                 String                     @map("account_id") @db.Uuid
  active                    Boolean                    @default(true)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account                   LedgerAccount              @relation("ExpenseCategoryAccount", fields: [accountId], references: [id], onDelete: Restrict)
  expenses                  Expense[]
  recurringExpenseTemplates RecurringExpenseTemplate[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@map("expense_categories")
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  VOID
  CANCELLED
}

/// Immediately-paid spend -- a single amount/tax line, not a multi-line document like Bill (per
/// build spec §5's field list: "Payee/vendor, date, paid-through account, category/account, amount,
/// tax, receipt", no "lines"). `post()` is the only state that touches the ledger (debit
/// category/expense account + recoverable tax, credit the paid-through account directly -- no AP
/// leg, this is cash-out, not a liability first); `submit`/`approve` are optional pre-post gates
/// ("approval configurable" read as permission-gated: anyone holding `purchases.expenses.post` can
/// post straight from DRAFT, skipping the approval hop entirely). Receipts attach via the generic
/// `Attachment` model (`entityType: 'EXPENSE'`).
model Expense {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  payeeVendorId          String?          @map("payee_vendor_id") @db.Uuid
  payeeName              String?          @map("payee_name") @db.VarChar(160)
  expenseNumber          String?          @map("expense_number") @db.VarChar(64)
  status                 ExpenseStatus    @default(DRAFT)
  expenseDate            DateTime         @map("expense_date") @db.Date
  paidThroughAccountId   String           @map("paid_through_account_id") @db.Uuid
  categoryId             String?          @map("category_id") @db.Uuid
  currency               String           @db.Char(3)
  amountMinor            BigInt           @map("amount_minor") @db.BigInt
  taxCodeId              String?          @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?          @map("tax_code_snapshot") @db.VarChar(24)
  taxTreatmentSnapshot   TaxTreatment?    @map("tax_treatment_snapshot")
  taxRecoverableSnapshot Boolean?         @map("tax_recoverable_snapshot")
  taxRatePercentSnapshot Decimal?         @map("tax_rate_percent_snapshot") @db.Decimal(7, 4)
  taxableAmountMinor     BigInt?          @map("taxable_amount_minor") @db.BigInt
  taxAmountMinor         BigInt?          @map("tax_amount_minor") @db.BigInt
  totalMinor             BigInt           @default(0) @map("total_minor") @db.BigInt
  journalId              String?          @unique @map("journal_id") @db.Uuid
  voidedAt               DateTime?        @map("voided_at") @db.Timestamptz(6)
  createdByUserId        String           @map("created_by_user_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payeeVendor            Vendor?          @relation(fields: [payeeVendorId], references: [id], onDelete: SetNull)
  paidThroughAccount     LedgerAccount    @relation("ExpensePaidThroughAccount", fields: [paidThroughAccountId], references: [id], onDelete: Restrict)
  category               ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCode                TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  journal                Journal?         @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy              User             @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, status, expenseDate])
  @@index([organizationId, payeeVendorId])
  @@map("expenses")
}

enum VendorCreditStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

/// Payable-side mirror of CreditNote, minus a refund path (not in Phase 3's build-spec field list
/// for Vendor Credits, unlike Credit Notes) -- issues into the `vendor_credit` asset account, not
/// directly against `accounts_payable`; `allocate()` is what actually posts `DR accounts_payable,
/// CR vendor_credit` against a specific Bill, one journal per Bill, mirroring
/// `CreditNotesService#allocate` exactly including its over-allocation guard shape.
model VendorCredit {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  vendorId           String                   @map("vendor_id") @db.Uuid
  sourceBillId       String?                  @map("source_bill_id") @db.Uuid
  reason             String?                  @db.VarChar(240)
  vendorCreditNumber String?                  @map("vendor_credit_number") @db.VarChar(64)
  status             VendorCreditStatus       @default(DRAFT)
  issueDate          DateTime?                @map("issue_date") @db.Date
  currency           String                   @db.Char(3)
  subtotalMinor      BigInt                   @default(0) @map("subtotal_minor") @db.BigInt
  taxTotalMinor      BigInt                   @default(0) @map("tax_total_minor") @db.BigInt
  totalMinor         BigInt                   @default(0) @map("total_minor") @db.BigInt
  appliedMinor       BigInt                   @default(0) @map("applied_minor") @db.BigInt
  remainingMinor     BigInt                   @default(0) @map("remaining_minor") @db.BigInt
  journalId          String?                  @unique @map("journal_id") @db.Uuid
  voidedAt           DateTime?                @map("voided_at") @db.Timestamptz(6)
  createdByUserId    String                   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  sourceBill         Bill?                    @relation(fields: [sourceBillId], references: [id], onDelete: SetNull)
  journal            Journal?                 @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("VendorCreditCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines              VendorCreditLine[]
  allocations        VendorCreditAllocation[]

  @@unique([organizationId, vendorCreditNumber])
  @@index([organizationId, status, issueDate])
  @@index([organizationId, vendorId])
  @@map("vendor_credits")
}

model VendorCreditLine {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String         @map("organization_id") @db.Uuid
  vendorCreditId         String         @map("vendor_credit_id") @db.Uuid
  lineNumber             Int            @map("line_number") @db.SmallInt
  itemId                 String?        @map("item_id") @db.Uuid
  descriptionSnapshot    String         @map("description_snapshot") @db.VarChar(240)
  quantity               Decimal        @db.Decimal(18, 4)
  unitPriceMinor         BigInt         @map("unit_price_minor") @db.BigInt
  discountMinor          BigInt         @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor         BigInt         @map("line_total_minor") @db.BigInt
  taxCodeId              String?        @map("tax_code_id") @db.Uuid
  taxCodeSnapshot        String?        @map("tax_code_snapshot") @db.VarChar(24)
  taxTreatmentSnapshot   TaxTreatment?  @map("tax_treatment_snapshot")
  taxRecoverableSnapshot Boolean?       @map("tax_recoverable_snapshot")
  taxRatePercentSnapshot Decimal?       @map("tax_rate_percent_snapshot") @db.Decimal(7, 4)
  taxableAmountMinor     BigInt?        @map("taxable_amount_minor") @db.BigInt
  taxAmountMinor         BigInt?        @map("tax_amount_minor") @db.BigInt
  accountId              String?        @map("account_id") @db.Uuid
  projectTag             String?        @map("project_tag") @db.VarChar(80)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCredit           VendorCredit   @relation(fields: [vendorCreditId], references: [id], onDelete: Cascade)
  item                   Item?          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode                TaxCode?       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  account                LedgerAccount? @relation("VendorCreditLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([vendorCreditId, lineNumber])
  @@index([organizationId, vendorCreditId])
  @@index([taxCodeId])
  @@map("vendor_credit_lines")
}

model VendorCreditAllocation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  vendorCreditId String       @map("vendor_credit_id") @db.Uuid
  billId         String       @map("bill_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor") @db.BigInt
  journalId      String       @unique @map("journal_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorCredit   VendorCredit @relation(fields: [vendorCreditId], references: [id], onDelete: Cascade)
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  journal        Journal      @relation(fields: [journalId], references: [id], onDelete: Restrict)

  @@index([organizationId, vendorCreditId])
  @@index([organizationId, billId])
  @@map("vendor_credit_allocations")
}

/// Payable-side mirror of PaymentReceived: posted once at recording time (AP debit vs cash/bank
/// credit) -- no draft state. `allocatedMinor`/`unappliedMinor`/`status` are derived and updated
/// atomically alongside `PaymentMadeAllocation` rows and the target bills'
/// paidMinor/balanceMinor/status in `PaymentsMadeService#allocate`, mirroring
/// `PaymentsService#allocate` exactly.
model PaymentMade {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  vendorId          String                  @map("vendor_id") @db.Uuid
  paymentNumber     String?                 @map("payment_number") @db.VarChar(64)
  status            PaymentStatus           @default(UNAPPLIED)
  paidDate          DateTime                @map("paid_date") @db.Date
  currency          String                  @db.Char(3)
  amountMinor       BigInt                  @map("amount_minor") @db.BigInt
  allocatedMinor    BigInt                  @default(0) @map("allocated_minor") @db.BigInt
  unappliedMinor    BigInt                  @map("unapplied_minor") @db.BigInt
  paidFromAccountId String?                 @map("paid_from_account_id") @db.Uuid
  journalId         String?                 @unique @map("journal_id") @db.Uuid
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paidFromAccount   LedgerAccount?          @relation("PaymentMadePaidFromAccount", fields: [paidFromAccountId], references: [id], onDelete: Restrict)
  journal           Journal?                @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("PaymentMadeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations       PaymentMadeAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, paidDate])
  @@index([organizationId, vendorId])
  @@map("payments_made")
}

/// One payment's application against one bill. Unique on (paymentId, billId) -- a second
/// allocation from the same payment to the same bill increments this row rather than inserting a
/// duplicate, mirroring PaymentAllocation.
model PaymentMadeAllocation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  billId         String       @map("bill_id") @db.Uuid
  amountMinor    BigInt       @map("amount_minor") @db.BigInt
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        PaymentMade  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([organizationId, paymentId])
  @@index([organizationId, billId])
  @@map("payment_made_allocations")
}

/// A template that `RecurringBillsService#runDueTemplates` sweeps to generate real bills via
/// `BillsService#createDraft`/`issueBill` -- mirrors `RecurringInvoiceTemplate` exactly. `autoCreate`
/// gates auto-*issue* after the draft is always created (same slightly-confusing but consistent
/// naming as the Sales original -- kept for consistency rather than renamed, since the meaning
/// isn't unique to this template). No `autoSend` -- Bills are received documents, not sent ones.
model RecurringBillTemplate {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                      @map("organization_id") @db.Uuid
  vendorId             String                      @map("vendor_id") @db.Uuid
  cadence              RecurringCadence
  startDate            DateTime                    @map("start_date") @db.Date
  endDate              DateTime?                   @map("end_date") @db.Date
  nextRunDate          DateTime                    @map("next_run_date") @db.Date
  autoCreate           Boolean                     @default(true) @map("auto_create")
  active               Boolean                     @default(true)
  currency             String                      @db.Char(3)
  lastRunOccurrenceKey String?                     @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String                      @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor               Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("RecurringBillTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines                RecurringBillTemplateLine[]

  @@index([organizationId, active, nextRunDate])
  @@index([organizationId, vendorId])
  @@map("recurring_bill_templates")
}

model RecurringBillTemplateLine {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  templateId          String                @map("template_id") @db.Uuid
  lineNumber          Int                   @map("line_number") @db.SmallInt
  itemId              String?               @map("item_id") @db.Uuid
  descriptionSnapshot String                @map("description_snapshot") @db.VarChar(240)
  quantity            Decimal               @db.Decimal(18, 4)
  unitPriceMinor      BigInt                @map("unit_price_minor") @db.BigInt
  discountMinor       BigInt                @default(0) @map("discount_minor") @db.BigInt
  lineTotalMinor      BigInt                @map("line_total_minor") @db.BigInt
  taxCodeId           String?               @map("tax_code_id") @db.Uuid
  accountId           String?               @map("account_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template            RecurringBillTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item                Item?                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  taxCode             TaxCode?              @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  account             LedgerAccount?        @relation("RecurringBillTemplateLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([templateId, lineNumber])
  @@index([organizationId, templateId])
  @@map("recurring_bill_template_lines")
}

/// A template that `RecurringExpensesService#runDueTemplates` sweeps to generate real expenses via
/// `ExpensesService#createDraft`/`post`. Unlike RecurringBillTemplate, mirrors Expense's own flat
/// single-amount shape directly -- no line-items sub-table, since Expense itself has none.
model RecurringExpenseTemplate {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  payeeVendorId        String?          @map("payee_vendor_id") @db.Uuid
  payeeName            String?          @map("payee_name") @db.VarChar(160)
  cadence              RecurringCadence
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime?        @map("end_date") @db.Date
  nextRunDate          DateTime         @map("next_run_date") @db.Date
  autoCreate           Boolean          @default(true) @map("auto_create")
  active               Boolean          @default(true)
  paidThroughAccountId String           @map("paid_through_account_id") @db.Uuid
  categoryId           String?          @map("category_id") @db.Uuid
  currency             String           @db.Char(3)
  amountMinor          BigInt           @map("amount_minor") @db.BigInt
  taxCodeId            String?          @map("tax_code_id") @db.Uuid
  lastRunOccurrenceKey String?          @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payeeVendor          Vendor?          @relation(fields: [payeeVendorId], references: [id], onDelete: SetNull)
  paidThroughAccount   LedgerAccount    @relation("RecurringExpenseTemplatePaidThroughAccount", fields: [paidThroughAccountId], references: [id], onDelete: Restrict)
  category             ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxCode              TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  createdBy            User             @relation("RecurringExpenseTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, active, nextRunDate])
  @@index([organizationId, payeeVendorId])
  @@map("recurring_expense_templates")
}

enum OpeningBalanceBatchStatus {
  DRAFT
  VALIDATED
  FINALIZED
  VOID
}

/// One side of a party-level opening balance. RECEIVABLE lines roll into the accounts_receivable
/// control account and must reference a contact; PAYABLE lines roll into accounts_payable and must
/// reference a vendor.
enum OpeningBalancePartySide {
  RECEIVABLE
  PAYABLE
}

model OpeningBalanceBatch {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  status            OpeningBalanceBatchStatus @default(DRAFT)
  asOfDate          DateTime                  @map("as_of_date") @db.Date
  description       String?                   @db.VarChar(240)
  journalId         String?                   @unique @map("journal_id") @db.Uuid
  validatedAt       DateTime?                 @map("validated_at") @db.Timestamptz(6)
  finalizedAt       DateTime?                 @map("finalized_at") @db.Timestamptz(6)
  finalizedByUserId String?                   @map("finalized_by_user_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal           Journal?                  @relation(fields: [journalId], references: [id], onDelete: SetNull)
  finalizedBy       User?                     @relation("OpeningBalanceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  lines             OpeningBalanceLine[]
  partyLines        OpeningBalancePartyLine[]

  @@index([organizationId, status])
  @@index([organizationId, asOfDate])
  @@map("opening_balance_batches")
}

model OpeningBalanceLine {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  batchId        String              @map("batch_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  debitMinor     BigInt              @default(0) @map("debit_minor")
  creditMinor    BigInt              @default(0) @map("credit_minor")
  description    String?             @db.VarChar(240)
  batch          OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  account        LedgerAccount       @relation("OpeningBalanceLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId, batchId])
  @@map("opening_balance_lines")
}

model OpeningBalancePartyLine {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  batchId        String                  @map("batch_id") @db.Uuid
  side           OpeningBalancePartySide
  amountMinor    BigInt                  @map("amount_minor")
  nameSnapshot   String                  @map("name_snapshot") @db.VarChar(160)
  contactId      String?                 @map("contact_id") @db.Uuid
  vendorId       String?                 @map("vendor_id") @db.Uuid
  batch          OpeningBalanceBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact        Contact?                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  vendor         Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([organizationId, batchId])
  @@index([organizationId, side])
  @@map("opening_balance_party_lines")
}

model RecurringJournalTemplate {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                         @map("organization_id") @db.Uuid
  name                 String                         @db.VarChar(120)
  memo                 String?                        @db.VarChar(240)
  cadence              RecurringCadence
  startDate            DateTime                       @map("start_date") @db.Date
  endDate              DateTime?                      @map("end_date") @db.Date
  nextRunDate          DateTime                       @map("next_run_date") @db.Date
  active               Boolean                        @default(true)
  lastRunOccurrenceKey String?                        @map("last_run_occurrence_key") @db.VarChar(100)
  createdByUserId      String                         @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines                RecurringJournalTemplateLine[]
  createdBy            User                           @relation("RecurringJournalTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  vendor               Vendor?                        @relation(fields: [vendorId], references: [id])
  vendorId             String?                        @db.Uuid

  @@index([organizationId, active, nextRunDate])
  @@map("recurring_journal_templates")
}

model RecurringJournalTemplateLine {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  templateId     String                   @map("template_id") @db.Uuid
  lineNumber     Int                      @map("line_number") @db.SmallInt
  accountId      String                   @map("account_id") @db.Uuid
  debitMinor     BigInt                   @default(0) @map("debit_minor")
  creditMinor    BigInt                   @default(0) @map("credit_minor")
  description    String?                  @db.VarChar(240)
  template       RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account        LedgerAccount            @relation("RecurringJournalTemplateLineAccount", fields: [accountId], references: [id], onDelete: Restrict)
  organization   Organization             @relation(fields: [organizationId], references: [id])

  @@index([organizationId, templateId])
  @@map("recurring_journal_template_lines")
}

/// One period-end FX revaluation execution. The batch restates foreign-currency monetary balances
/// to the reporting-rate value as of `as_of_date` and posts only the aggregate difference through
/// the posting-rule library -- distinct from `prepareFxPosting`'s per-journal conversion.
model FxRevaluationRun {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  asOfDate        DateTime     @map("as_of_date") @db.Date
  baseCurrency    String       @map("base_currency") @db.Char(3)
  journalId       String       @unique @map("journal_id") @db.Uuid
  gainMinor       BigInt       @default(0) @map("gain_minor")
  lossMinor       BigInt       @default(0) @map("loss_minor")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal         Journal      @relation("FxRevaluationJournal", fields: [journalId], references: [id], onDelete: Restrict)
  createdBy       User         @relation("FxRevaluationRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, asOfDate])
  @@index([organizationId, createdAt])
  @@map("fx_revaluation_runs")
}

/// Cash-rounding policy for document totals. NONE keeps exact computed totals; HALF_UP rounds the
/// payable amount to `rounding_unit_minor` and posts the difference to the rounding account.
enum RoundingMode {
  NONE
  HALF_UP
}
