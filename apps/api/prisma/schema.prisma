  @@unique([organizationId, operation, key])
  @@index([organizationId, resourceType, resourceId], map: "ledger_idempotency_keys_organization_id_resource_type_resource_")
  @@map("ledger_idempotency_keys")
}

/// Organization-scoped tax code catalog, seeded from the country pack and then fully editable.
/// Codes are archived rather than hard-deleted once they have posted journal-line history.
model TaxCode {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                String                         @map("organization_id") @db.Uuid
  code                          String                         @db.VarChar(24)
  name                          String                         @db.VarChar(120)
  treatment                     TaxTreatment
  recoverable                   Boolean                        @default(false)
  status                        TaxCodeStatus                  @default(ACTIVE)
  description                   String?                        @db.VarChar(240)
  salesTaxAccountId             String?                        @map("sales_tax_account_id") @db.Uuid
  purchaseTaxAccountId          String?                        @map("purchase_tax_account_id") @db.Uuid
  systemSeed                    Boolean                        @default(false) @map("system_seed")
  archivedAt                    DateTime?                      @map("archived_at") @db.Timestamptz(6)
  createdAt                     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesTaxAccount               LedgerAccount?                 @relation("TaxCodeSalesAccount", fields: [salesTaxAccountId], references: [id], onDelete: SetNull)
  purchaseTaxAccount            LedgerAccount?                 @relation("TaxCodePurchaseAccount", fields: [purchaseTaxAccountId], references: [id], onDelete: SetNull)
  rates                         TaxRate[]
  journalLines                  JournalLine[]
  itemsAsDefaultTaxCode         Item[]                         @relation("ItemDefaultTaxCode")
  itemsAsDefaultPurchaseTaxCode Item[]                         @relation("ItemDefaultPurchaseTaxCode")
  invoiceLines                  InvoiceLine[]
  creditNoteLines               CreditNoteLine[]
  quoteLines                    QuoteLine[]
  salesOrderLines               SalesOrderLine[]
  recurringInvoiceTemplateLines RecurringInvoiceTemplateLine[]
  purchaseOrderLines            PurchaseOrderLine[]
  billLines                     BillLine[]
  expenses                      Expense[]
  vendorCreditLines             VendorCreditLine[]
  recurringBillTemplateLines    RecurringBillTemplateLine[]
  recurringExpenseTemplates     RecurringExpenseTemplate[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("tax_codes")
}

/// Effective-dated rate history for a tax code. Never edited once used by a posted line; new
/// rate periods are new rows, mirroring why posted journals are immutable.
model TaxRate {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  taxCodeId      String       @map("tax_code_id") @db.Uuid
  ratePercent    Decimal      @map("rate_percent") @db.Decimal(7, 4)
  effectiveFrom  DateTime     @map("effective_from") @db.Date
  effectiveTo    DateTime?    @map("effective_to") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCode        TaxCode      @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)

  @@unique([taxCodeId, effectiveFrom])
  @@index([organizationId, taxCodeId, effectiveFrom])
  @@map("tax_rates")
}

/// Sales customer (and, in a later phase, purchasing vendor) record. `type` distinguishes the two
/// so the two Sales/Purchases modules can share one contact book without a duplicate table.
model Contact {
