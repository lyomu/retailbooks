{
  "name": "@retailbooks/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --entryFile worker --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@node-rs/argon2": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@retailbooks/accounting-core": "*",
    "@retailbooks/contracts": "*",
    "bullmq": "^6.0.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.5.11"
  }
}
